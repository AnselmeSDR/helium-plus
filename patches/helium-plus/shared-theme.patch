+#ifndef CHROME_BROWSER_UI_HELIUM_PLUS_SHARED_THEME_H_
+#define CHROME_BROWSER_UI_HELIUM_PLUS_SHARED_THEME_H_
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/no_destructor.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_manager_observer.h"
+#include "chrome/browser/profiles/profile_observer.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+class PrefRegistrySimple;
+class Profile;
+
+namespace helium_plus {
+
+// Like Arc, the same theme in every profile. Its colors, grayscale and color
+// scheme are shared settings (see SharedSettings); this also shares the theme
+// extension: a profile that does not have it loads it from the profile that
+// installed it (a copy for a package, from the Chrome Web Store), and a profile
+// using a theme extension drops it when the others no longer use one. The theme
+// is kept in Local State for the profiles loaded later.
+class SharedTheme : public ProfileManagerObserver, public ProfileObserver {
+ public:
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+  static void EnsureStarted();
+
+  // Whether the shared theme is being applied to a profile: its theme settings
+  // change before getting the shared values again, which must not be shared.
+  static bool IsApplying();
+
+  SharedTheme(const SharedTheme&) = delete;
+  SharedTheme& operator=(const SharedTheme&) = delete;
+
+ private:
+  friend class base::NoDestructor<SharedTheme>;
+  class ProfileTheme;
+
+  static SharedTheme* Get();
+
+  SharedTheme();
+  ~SharedTheme() override;
+
+  void AddProfile(Profile* profile);
+  void OnProfileReady(Profile* profile);
+  void OnThemeChanged(Profile* profile);
+  // Keeps the theme of `profile` as the shared theme.
+  void SaveTheme(Profile* profile);
+  void ApplyTheme(Profile* profile);
+  // Installs into `profile` the copy of a theme installed from a package.
+  void InstallThemeCopy(Profile* profile,
+                        const std::string& id,
+                        const std::string& key,
+                        bool from_webstore,
+                        const base::FilePath& copy);
+  void OnThemeLoaded(Profile* profile);
+
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override;
+  void OnProfileManagerDestroying() override;
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+  // The profiles whose extensions are loaded.
+  std::map<Profile*, std::unique_ptr<ProfileTheme>> profiles_;
+  bool applying_ = false;
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      profile_manager_observation_{this};
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver>
+      profile_observations_{this};
+};
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_HELIUM_PLUS_SHARED_THEME_H_
