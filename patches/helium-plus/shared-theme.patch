+#include "chrome/browser/ui/helium_plus/shared_theme.h"
+
+#include <string>
+
+#include "base/auto_reset.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/raw_ptr.h"
+#include "base/one_shot_event.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/themes/theme_service.h"
+#include "chrome/browser/themes/theme_service_factory.h"
+#include "chrome/browser/themes/theme_service_observer.h"
+#include "chrome/browser/ui/helium_plus/shared_settings.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "extensions/browser/crx_installer.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_system.h"
+#include "extensions/browser/unpacked_installer.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+
+namespace helium_plus {
+
+namespace {
+
+// The theme extension of the profiles: its id (empty: none), the directory to
+// load it from and, if it was installed from a package (Chrome Web Store), its
+// public key and origin.
+constexpr char kSharedThemePref[] = "helium_plus.shared_theme";
+constexpr char kIdKey[] = "id";
+constexpr char kPathKey[] = "path";
+constexpr char kKeyKey[] = "key";
+constexpr char kFromWebstoreKey[] = "from_webstore";
+
+// Copies the theme at `path` into a new temporary directory, without the
+// signature of the original files. Returns the copy, or an empty path.
+base::FilePath CopyTheme(const base::FilePath& path) {
+  base::FilePath temp_dir;
+  if (!base::CreateNewTempDirectory(FILE_PATH_LITERAL("helium_plus_theme"),
+                                    &temp_dir)) {
+    return base::FilePath();
+  }
+  const base::FilePath copy = temp_dir.Append(path.BaseName());
+  if (!base::CopyDirectory(path, copy, /*recursive=*/true)) {
+    base::DeletePathRecursively(temp_dir);
+    return base::FilePath();
+  }
+  base::DeletePathRecursively(copy.Append(extensions::kMetadataFolder));
+  return copy;
+}
+
+}  // namespace
+
+class SharedTheme::ProfileTheme : public ThemeServiceObserver {
+ public:
+  explicit ProfileTheme(Profile* profile) : profile_(profile) {
+    observation_.Observe(ThemeServiceFactory::GetForProfile(profile));
+  }
+
+  // ThemeServiceObserver:
+  void OnThemeChanged() override {
+    SharedTheme::Get()->OnThemeChanged(profile_);
+  }
+
+  // Whether the theme extension is being loaded into the profile.
+  bool loading = false;
+
+ private:
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<ThemeService, ThemeServiceObserver> observation_{
+      this};
+};
+
+// static
+void SharedTheme::RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kSharedThemePref);
+}
+
+// static
+void SharedTheme::EnsureStarted() {
+  Get();
+}
+
+// static
+bool SharedTheme::IsApplying() {
+  return Get()->applying_;
+}
+
+// static
+SharedTheme* SharedTheme::Get() {
+  static base::NoDestructor<SharedTheme> shared_theme;
+  return shared_theme.get();
+}
+
+SharedTheme::SharedTheme() {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  profile_manager_observation_.Observe(profile_manager);
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    AddProfile(profile);
+  }
+}
+
+SharedTheme::~SharedTheme() = default;
+
+void SharedTheme::AddProfile(Profile* profile) {
+  if (!profile->IsRegularProfile() ||
+      profile_observations_.IsObservingSource(profile)) {
+    return;
+  }
+  profile_observations_.AddObservation(profile);
+  // The ThemeService gets ready on the same signal: wait for it too.
+  extensions::ExtensionSystem::Get(profile)->ready().Post(
+      FROM_HERE,
+      base::BindOnce(
+          [](SharedTheme* shared_theme, Profile* profile) {
+            base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE,
+                base::BindOnce(&SharedTheme::OnProfileReady,
+                               base::Unretained(shared_theme), profile));
+          },
+          base::Unretained(this), profile));
+}
+
+void SharedTheme::OnProfileReady(Profile* profile) {
+  if (!profile_observations_.IsObservingSource(profile) ||
+      profiles_.contains(profile)) {
+    return;
+  }
+  profiles_[profile] = std::make_unique<ProfileTheme>(profile);
+  if (g_browser_process->local_state()
+          ->GetDict(kSharedThemePref)
+          .FindString(kIdKey)) {
+    ApplyTheme(profile);
+  } else {
+    SaveTheme(profile);
+  }
+}
+
+void SharedTheme::OnThemeChanged(Profile* profile) {
+  if (applying_ || !profiles_.contains(profile)) {
+    return;
+  }
+  SaveTheme(profile);
+  for (const auto& [other, profile_theme] : profiles_) {
+    if (other != profile) {
+      ApplyTheme(other);
+    }
+  }
+}
+
+void SharedTheme::SaveTheme(Profile* profile) {
+  ThemeService* theme_service = ThemeServiceFactory::GetForProfile(profile);
+  PrefService* local_state = g_browser_process->local_state();
+  base::DictValue theme;
+  if (!theme_service->UsingExtensionTheme()) {
+    theme.Set(kIdKey, std::string());
+    local_state->SetDict(kSharedThemePref, std::move(theme));
+    return;
+  }
+  const std::string id = theme_service->GetThemeID();
+  theme.Set(kIdKey, id);
+  const extensions::Extension* extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          id);
+  if (!extension) {
+    // Still loading: keep where it comes from.
+    const std::string* shared_id =
+        local_state->GetDict(kSharedThemePref).FindString(kIdKey);
+    if (!shared_id || *shared_id != id) {
+      local_state->SetDict(kSharedThemePref, std::move(theme));
+    }
+    return;
+  }
+  theme.Set(kPathKey, extension->path().AsUTF8Unsafe());
+  if (!extensions::Manifest::IsUnpackedLocation(extension->location())) {
+    theme.Set(kKeyKey, extension->public_key());
+    theme.Set(kFromWebstoreKey, extension->from_webstore());
+  }
+  local_state->SetDict(kSharedThemePref, std::move(theme));
+}
+
+void SharedTheme::ApplyTheme(Profile* profile) {
+  const base::DictValue& shared =
+      g_browser_process->local_state()->GetDict(kSharedThemePref);
+  const std::string* id = shared.FindString(kIdKey);
+  ThemeService* theme_service = ThemeServiceFactory::GetForProfile(profile);
+  if (!id || theme_service->UsingPolicyTheme()) {
+    return;
+  }
+  base::AutoReset<bool> applying(&applying_, true);
+  if (id->empty()) {
+    if (theme_service->UsingExtensionTheme()) {
+      // Dropping the theme extension also resets the theme settings: they get
+      // their shared values again.
+      theme_service->SetIsGrayscale(false);
+      SharedSettings::ApplySharedSettings(profile);
+    }
+    return;
+  }
+  if (theme_service->UsingExtensionTheme() &&
+      theme_service->GetThemeID() == *id) {
+    return;
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  if (const extensions::Extension* extension =
+          registry->enabled_extensions().GetByID(*id);
+      extension && extension->is_theme()) {
+    theme_service->SetTheme(extension);
+    return;
+  }
+  if (registry->disabled_extensions().GetByID(*id)) {
+    theme_service->RevertToExtensionTheme(*id);
+    return;
+  }
+  // Loading a theme applies it.
+  const std::string* path = shared.FindString(kPathKey);
+  ProfileTheme& profile_theme = *profiles_[profile];
+  if (!path || path->empty() || profile_theme.loading) {
+    return;
+  }
+  profile_theme.loading = true;
+  const base::FilePath theme_path = base::FilePath::FromUTF8Unsafe(*path);
+  if (const std::string* key = shared.FindString(kKeyKey)) {
+    // Installing a package moves its files: install a copy.
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&CopyTheme, theme_path),
+        base::BindOnce(&SharedTheme::InstallThemeCopy, base::Unretained(this),
+                       profile, *id, *key,
+                       shared.FindBool(kFromWebstoreKey).value_or(false)));
+    return;
+  }
+  scoped_refptr<extensions::UnpackedInstaller> installer =
+      extensions::UnpackedInstaller::Create(profile);
+  installer->set_be_noisy_on_failure(false);
+  installer->set_completion_callback(base::BindOnce(
+      [](SharedTheme* shared_theme, Profile* profile,
+         const extensions::Extension*, const base::FilePath&,
+         const std::u16string&) { shared_theme->OnThemeLoaded(profile); },
+      base::Unretained(this), profile));
+  installer->Load(theme_path);
+}
+
+void SharedTheme::InstallThemeCopy(Profile* profile,
+                                   const std::string& id,
+                                   const std::string& key,
+                                   bool from_webstore,
+                                   const base::FilePath& copy) {
+  if (copy.empty() || !profiles_.contains(profile)) {
+    if (!copy.empty()) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::GetDeletePathRecursivelyCallback(copy.DirName()));
+    }
+    OnThemeLoaded(profile);
+    return;
+  }
+  scoped_refptr<extensions::CrxInstaller> installer =
+      extensions::CrxInstaller::CreateSilent(profile);
+  installer->set_delete_source(true);
+  installer->set_install_source(extensions::mojom::ManifestLocation::kInternal);
+  installer->set_creation_flags(from_webstore
+                                    ? extensions::Extension::FROM_WEBSTORE
+                                    : extensions::Extension::NO_FLAGS);
+  installer->AddInstallerCallback(base::BindOnce(
+      [](SharedTheme* shared_theme, Profile* profile,
+         const base::FilePath& temp_dir,
+         const std::optional<extensions::CrxInstallError>&) {
+        base::ThreadPool::PostTask(
+            FROM_HERE, {base::MayBlock()},
+            base::GetDeletePathRecursivelyCallback(temp_dir));
+        shared_theme->OnThemeLoaded(profile);
+      },
+      base::Unretained(this), profile, copy.DirName()));
+  installer->InstallUnpackedCrx(id, key, copy);
+}
+
+void SharedTheme::OnThemeLoaded(Profile* profile) {
+  if (auto it = profiles_.find(profile); it != profiles_.end()) {
+    it->second->loading = false;
+  }
+}
+
+void SharedTheme::OnProfileAdded(Profile* profile) {
+  AddProfile(profile);
+}
+
+void SharedTheme::OnProfileManagerDestroying() {
+  profiles_.clear();
+  profile_observations_.RemoveAllObservations();
+  profile_manager_observation_.Reset();
+}
+
+void SharedTheme::OnProfileWillBeDestroyed(Profile* profile) {
+  profiles_.erase(profile);
+  profile_observations_.RemoveObservation(profile);
+}
+
+}  // namespace helium_plus
