+    std::vector<sessions::SerializedNavigationEntry>& result);
+
+// True when `tab` shows its anchor URL: saved tab groups must not navigate it
+// back to the last URL they stored.
+bool IsAtAnchor(const tabs::TabInterface& tab);
+
+// True when the user closed `tab`: it sleeps on its anchor URL and its close
+// button is hidden. A tab that only hibernates is not closed.
+bool IsClosedAnchoredTab(const tabs::TabInterface& tab);
+
