+void HibernateIfHidden(base::WeakPtr<content::WebContents> contents) {
+  if (!contents) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(contents.get());
+  if (!tab || tab->IsVisible() || contents->WasDiscarded() ||
+      !performance_manager::PerformanceManager::IsAvailable()) {
+    return;
+  }
+  base::WeakPtr<performance_manager::PageNode> page_node =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents.get());
+  if (!page_node) {
+    return;
+  }
+  performance_manager::user_tuning::DiscardPage(
+      page_node.get(), ::mojom::LifecycleUnitDiscardReason::EXTERNAL,
+      /*ignore_minimum_time_in_background=*/true);
+}
+
+// Discarding destroys the WebContents, so it never runs while the caller (or
+// the WebContents notifying its observers) still uses it.
+void PostHibernateIfHidden(content::WebContents* contents) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HibernateIfHidden, contents->GetWeakPtr()));
+}
+
+// Hibernates a tab once its navigation back to the anchor has loaded.
+class HibernateAfterLoad
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<HibernateAfterLoad> {
+ public:
+  ~HibernateAfterLoad() override = default;
+
+  // content::WebContentsObserver:
+  void DidStopLoading() override {
+    content::WebContents* contents = web_contents();
+    contents->RemoveUserData(UserDataKey());  // Deletes `this`.
+    PostHibernateIfHidden(contents);
+  }
+
+ private:
+  friend class content::WebContentsUserData<HibernateAfterLoad>;
+
+  explicit HibernateAfterLoad(content::WebContents* contents)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<HibernateAfterLoad>(*contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(HibernateAfterLoad);
+
+// Shows the home page in place of the closed tab: a tab already on it, else a
+// new tab.
+void ShowHomePage(TabStripModel& model, int closed_index) {
+  const GURL home_page = model.profile()->GetHomePage();
+  for (int i = 0; i < model.count(); ++i) {
+    if (i != closed_index &&
+        model.GetWebContentsAt(i)->GetVisibleURL() == home_page) {
+      model.ActivateTabAt(i);
+      return;
+    }
+  }
+  model.delegate()->AddTabAt(home_page, -1, /*foreground=*/true);
+}
+
+void LoadAnchor(content::WebContents* contents, const GURL& anchor_url) {
+  content::NavigationController::LoadURLParams params(anchor_url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  contents->GetController().LoadURLWithParams(params);
+}
+
+}  // namespace
+
+bool MaybeResetAnchoredTab(TabStripModel& model, tabs::TabInterface& tab) {
+  TabState* state = TabState::From(&tab);
+  if (!state || !state->IsAnchored() || !state->anchor_url().is_valid() ||
+      tab.IsSplit()) {
+    return false;
+  }
+  std::optional<int> index = model.GetIndexOfTab(&tab);
+  if (!index) {
+    return false;
+  }
+
+  content::WebContents* contents = tab.GetContents();
+  // A tab that left its anchor first goes back to it and stays open.
+  if (state->IsDiverged()) {
+    LoadAnchor(contents, state->anchor_url());
+    return true;
+  }
+
+  if (tab.IsActivated()) {
+    ShowHomePage(model, *index);
+  }
+  state->SetClosed(true);
+  if (contents->GetLastCommittedURL() == state->anchor_url()) {
+    PostHibernateIfHidden(contents);
+    return true;
+  }
+  HibernateAfterLoad::CreateForWebContents(contents);
+  LoadAnchor(contents, state->anchor_url());
+  return true;
+}
+
+bool ResetNavigationsToAnchor(
+    base::span<const sessions::SerializedNavigationEntry> navigations,
+    int selected_navigation,
+    const std::map<std::string, std::string>& extra_data,
+    std::vector<sessions::SerializedNavigationEntry>& result) {
+  auto url_it = extra_data.find(kAnchorUrlKey);
+  if (url_it == extra_data.end() || selected_navigation < 0 ||
+      static_cast<size_t>(selected_navigation) >= navigations.size()) {
+    return false;
+  }
+  const GURL anchor_url(url_it->second);
+  if (!anchor_url.is_valid() ||
+      navigations[selected_navigation].virtual_url() == anchor_url) {
+    return false;
+  }
+
+  // Keep the history up to the restored page, then add the anchor page. An
+  // empty page state makes the restore load the URL from scratch.
+  result.assign(navigations.begin(),
+                navigations.begin() + selected_navigation + 1);
+  sessions::SerializedNavigationEntry anchor;
+  anchor.set_index(selected_navigation + 1);
+  anchor.set_virtual_url(anchor_url);
+  anchor.set_original_request_url(anchor_url);
+  if (auto title_it = extra_data.find(kAnchorTitleKey);
+      title_it != extra_data.end()) {
+    anchor.set_title(base::UTF8ToUTF16(title_it->second));
+  }
+  anchor.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  anchor.set_timestamp(base::Time::Now());
+  result.push_back(std::move(anchor));
+  return true;
+}
+
+bool IsAtAnchor(const tabs::TabInterface& tab) {
+  const TabState* state = TabState::From(&tab);
+  return state && !state->anchor_url().is_empty() &&
+         tab.GetContents()->GetURL() == state->anchor_url();
+}
+
+bool IsClosedAnchoredTab(const tabs::TabInterface& tab) {
+  const TabState* state = TabState::From(&tab);
+  return state && state->IsClosed();
+}
