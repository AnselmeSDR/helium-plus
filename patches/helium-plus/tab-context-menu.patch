+
+bool IsFrench() {
+  return base::StartsWith(g_browser_process->GetApplicationLocale(), "fr");
+}
+
+}  // namespace
+
+std::u16string GetString(StringId id) {
+  const bool french = IsFrench();
+  switch (id) {
+    case StringId::kRenameTab:
+      return french ? u"Renommer l’onglet…" : u"Rename Tab…";
+    case StringId::kRenameTabTitle:
+      return french ? u"Renommer l’onglet" : u"Rename tab";
+    case StringId::kTabNameLabel:
+      return french ? u"Nom (vide : titre de la page)"
+                    : u"Name (empty: page title)";
+    case StringId::kReplaceAnchor:
+      return french ? u"Ancrer sur la page actuelle"
+                    : u"Anchor to Current Page";
+    case StringId::kCloseUngroupedTabs:
+      return french ? u"Fermer les onglets non groupés"
+                    : u"Close Ungrouped Tabs";
+  }
+}
+
+}  // namespace helium_plus
