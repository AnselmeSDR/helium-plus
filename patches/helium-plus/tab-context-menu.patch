+
+namespace helium_plus {
+
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kTabNameField);
+
+class TabRenameDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit TabRenameDialogDelegate(
+      base::OnceCallback<void(std::u16string)> callback)
+      : callback_(std::move(callback)) {}
+
+  void OnAccepted() {
+    std::u16string name(base::TrimWhitespace(
+        dialog_model()->GetTextfieldByUniqueId(kTabNameField)->text(),
+        base::TRIM_ALL));
+    std::move(callback_).Run(std::move(name));
+  }
+
+ private:
+  base::OnceCallback<void(std::u16string)> callback_;
+};
+
+}  // namespace
+
+void ShowTabRenameDialog(content::WebContents* web_contents,
+                         std::u16string current_name,
+                         base::OnceCallback<void(std::u16string)> callback) {
+  if (!web_contents) {
+    return;
+  }
+
+  auto delegate = std::make_unique<TabRenameDialogDelegate>(std::move(callback));
+  TabRenameDialogDelegate* delegate_ptr = delegate.get();
+  auto dialog_model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(GetString(StringId::kRenameTabTitle))
+          .AddTextfield(kTabNameField, GetString(StringId::kTabNameLabel),
+                        std::move(current_name))
+          .SetInitiallyFocusedField(kTabNameField)
+          .AddOkButton(base::BindOnce(&TabRenameDialogDelegate::OnAccepted,
+                                      base::Unretained(delegate_ptr)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+  auto dialog = views::BubbleDialogModelHost::CreateModal(
+      std::move(dialog_model), ui::mojom::ModalType::kChild);
+  constrained_window::ShowWebModalDialogViews(dialog.release(), web_contents);
+}
+
+}  // namespace helium_plus
