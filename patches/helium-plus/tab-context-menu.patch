+#include "chrome/browser/ui/helium_plus/tab_commands.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/helium_plus/strings.h"
+#include "chrome/browser/ui/helium_plus/tab_state.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/views/helium_plus/tab_rename_dialog.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/menus/simple_menu_model.h"
+#include "url/gurl.h"
+
+namespace helium_plus {
+
+namespace {
+
+bool IsUngrouped(const TabStripModel& model, int index) {
+  return !model.IsTabPinned(index) &&
+         !model.GetTabGroupForTab(index).has_value();
+}
+
+bool HasUngroupedTabs(const TabStripModel& model) {
+  for (int i = 0; i < model.count(); ++i) {
+    if (IsUngrouped(model, i)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const TabState* GetTabState(const TabStripModel& model, int index) {
+  const tabs::TabInterface* tab = model.GetTabAtIndex(index);
+  return tab ? TabState::From(tab) : nullptr;
+}
+
+bool CanReplaceAnchor(const TabStripModel& model, int index) {
+  const TabState* state = GetTabState(model, index);
+  if (!state || !state->IsAnchored()) {
+    return false;
+  }
+  const GURL& url = model.GetWebContentsAt(index)->GetLastCommittedURL();
+  return url.is_valid() && url != state->anchor_url();
+}
+
+void RenameTab(TabStripModel& model, int index) {
+  tabs::TabInterface* tab = model.GetTabAtIndex(index);
+  content::WebContents* host = model.GetActiveWebContents();
+  if (!tab || !host) {
+    return;
+  }
+  ShowTabRenameDialog(
+      host, TabUIHelper::From(tab)->GetTitle(),
+      base::BindOnce(
+          [](tabs::TabHandle handle, std::u16string name) {
+            tabs::TabInterface* renamed_tab = handle.Get();
+            if (TabState* state =
+                    renamed_tab ? TabState::From(renamed_tab) : nullptr) {
+              state->SetCustomTitle(std::move(name));
+            }
+          },
+          tab->GetHandle()));
+}
+
+}  // namespace
+
+bool IsTabCommandEnabled(const TabStripModel& model,
+                         int index,
+                         tabs::TabContextMenuCommand command) {
+  if (!model.ContainsIndex(index)) {
+    return false;
+  }
+  switch (command) {
+    case tabs::CommandRenameTab:
+      return true;
+    case tabs::CommandReplaceAnchor:
+      return CanReplaceAnchor(model, index);
+    case tabs::CommandCloseUngroupedTabs:
+      return HasUngroupedTabs(model);
+    default:
+      return false;
+  }
+}
+
+void ExecuteTabCommand(TabStripModel& model,
+                       int index,
+                       tabs::TabContextMenuCommand command) {
+  if (!IsTabCommandEnabled(model, index, command)) {
+    return;
+  }
+  switch (command) {
+    case tabs::CommandRenameTab:
+      RenameTab(model, index);
+      break;
+    case tabs::CommandReplaceAnchor:
+      TabState::From(model.GetTabAtIndex(index))->SetAnchorToCurrentPage();
+      break;
+    case tabs::CommandCloseUngroupedTabs:
+      CloseUngroupedTabs(model);
+      break;
+    default:
+      break;
+  }
+}
+
+void AddTabMenuItems(ui::SimpleMenuModel& menu,
+                     const TabStripModel& model,
+                     int index,
+                     size_t selected_count) {
+  menu.AddSeparator(ui::NORMAL_SEPARATOR);
+  if (selected_count == 1) {
+    menu.AddItem(tabs::CommandRenameTab, GetString(StringId::kRenameTab));
+    const TabState* state = GetTabState(model, index);
+    if (state && state->IsAnchored()) {
+      menu.AddItem(tabs::CommandReplaceAnchor,
+                   GetString(StringId::kReplaceAnchor));
+    }
+  }
+  menu.AddItem(tabs::CommandCloseUngroupedTabs,
+               GetString(StringId::kCloseUngroupedTabs));
+}
+
+void CloseUngroupedTabs(TabStripModel& model) {
+  std::vector<tabs::TabHandle> handles;
+  for (int i = 0; i < model.count(); ++i) {
+    if (IsUngrouped(model, i)) {
+      handles.push_back(model.GetTabAtIndex(i)->GetHandle());
+    }
+  }
+  if (handles.empty()) {
+    return;
+  }
+  if (handles.size() == static_cast<size_t>(model.count())) {
+    model.delegate()->AddTabAt(model.profile()->GetHomePage(), -1,
+                               /*foreground=*/true);
+  }
+  for (tabs::TabHandle handle : handles) {
+    if (tabs::TabInterface* tab = handle.Get()) {
+      model.CloseWebContents(tab->GetContents(),
+                             TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB |
+                                 TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
+
+}  // namespace helium_plus
