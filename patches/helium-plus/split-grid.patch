+bool IsSideBySide(split_tabs::SplitTabLayout layout) {
+  return layout == split_tabs::SplitTabLayout::kSideBySide;
+}
+
+// Size across the lines (width of a column side by side).
+int MainSize(const gfx::Rect& rect, bool side_by_side) {
+  return side_by_side ? rect.width() : rect.height();
+}
+
+// Size along a line (height of a column side by side).
+int CrossSize(const gfx::Rect& rect, bool side_by_side) {
+  return side_by_side ? rect.height() : rect.width();
+}
+
+// `ratios` summing to 1, or equal shares when they don't fit `count`.
+std::vector<double> NormalizeRatios(const std::vector<double>& ratios,
+                                    size_t count) {
+  const std::vector<double> equal(count, 1.0 / count);
+  if (ratios.size() != count ||
+      std::ranges::any_of(ratios, [](double ratio) { return !(ratio > 0); })) {
+    return equal;
+  }
+  const double sum = std::accumulate(ratios.begin(), ratios.end(), 0.0);
+  std::vector<double> normalized;
+  for (double ratio : ratios) {
+    normalized.push_back(ratio / sum);
+  }
+  return normalized;
+}
+
+// Splits `total` by `ratios`, each part at least `min_size` when they all fit.
+std::vector<int> Distribute(int total,
+                            const std::vector<double>& ratios,
+                            int min_size) {
+  const int count = static_cast<int>(ratios.size());
+  std::vector<int> sizes(count);
+  if (total < count * min_size) {
+    for (int i = 0; i < count; ++i) {
+      sizes[i] = total / count + (i < total % count ? 1 : 0);
+    }
+    return sizes;
+  }
+  // Rounding the cumulative positions leaves no pixel out.
+  double cumulative = 0;
+  int previous = 0;
+  for (int i = 0; i < count; ++i) {
+    cumulative += ratios[i];
+    const int end = i == count - 1 ? total : std::round(cumulative * total);
+    sizes[i] = end - previous;
+    previous = end;
+  }
+  for (int i = 0; i < count; ++i) {
+    // A part too small takes the missing size from the largest ones.
+    while (sizes[i] < min_size) {
+      auto largest = std::ranges::max_element(sizes);
+      const int taken = std::min(min_size - sizes[i], *largest - min_size);
+      if (taken <= 0) {
+        break;
+      }
+      *largest -= taken;
+      sizes[i] += taken;
+    }
+  }
+  return sizes;
+}
+
+// Index of the first pane of each line.
+std::vector<size_t> GetFirstPanes(const std::vector<int>& lines) {
+  std::vector<size_t> first_panes;
+  size_t pane = 0;
+  for (int line : lines) {
+    first_panes.push_back(pane);
+    pane += line;
+  }
+  return first_panes;
+}
+
+}  // namespace
+
+SplitGrid::SplitGrid() = default;
+SplitGrid::SplitGrid(const SplitGrid&) = default;
+SplitGrid& SplitGrid::operator=(const SplitGrid&) = default;
+SplitGrid::~SplitGrid() = default;
+
+SplitGrid CalculateSplitGrid(const gfx::Rect& bounds,
+                             size_t pane_count,
+                             const split_tabs::SplitTabVisualData& visual_data,
+                             int handle_size,
+                             int min_pane_size) {
+  const bool side_by_side = IsSideBySide(visual_data.split_layout());
+  const std::vector<int> lines = split_tabs::GetSplitGridLines(pane_count);
+  const int line_count = static_cast<int>(lines.size());
+  const int cross_size = CrossSize(bounds, side_by_side);
+  const std::vector<int> line_sizes = Distribute(
+      MainSize(bounds, side_by_side) - (line_count - 1) * handle_size,
+      NormalizeRatios(visual_data.line_ratios(), line_count), min_pane_size);
+
+  auto make_rect = [&](int main_start, int main_size, int cross_start,
+                       int cross_length) {
+    return side_by_side ? gfx::Rect(bounds.x() + main_start,
+                                    bounds.y() + cross_start, main_size,
+                                    cross_length)
+                        : gfx::Rect(bounds.x() + cross_start,
+                                    bounds.y() + main_start, cross_length,
+                                    main_size);
+  };
+
+  SplitGrid grid;
+  std::vector<gfx::Rect> pane_handles;
+  int main_start = 0;
+  for (int line = 0; line < line_count; ++line) {
+    const int size = line_sizes[line];
+    if (lines[line] == 1) {
+      grid.panes.push_back(make_rect(main_start, size, 0, cross_size));
+    } else {
+      const std::vector<double>& pane_ratios = visual_data.pane_ratios();
+      const double ratio =
+          line < static_cast<int>(pane_ratios.size()) &&
+                  pane_ratios[line] > 0 && pane_ratios[line] < 1
+              ? pane_ratios[line]
+              : 0.5;
+      const std::vector<int> pane_sizes = Distribute(
+          cross_size - handle_size, {ratio, 1 - ratio}, min_pane_size);
+      grid.panes.push_back(make_rect(main_start, size, 0, pane_sizes[0]));
+      pane_handles.push_back(
+          make_rect(main_start, size, pane_sizes[0], handle_size));
+      grid.panes.push_back(make_rect(main_start, size,
+                                     pane_sizes[0] + handle_size,
+                                     pane_sizes[1]));
+    }
+    main_start += size;
+    if (line < line_count - 1) {
+      grid.handles.push_back(make_rect(main_start, handle_size, 0, cross_size));
+      main_start += handle_size;
+    }
+  }
+  grid.handles.insert(grid.handles.end(), pane_handles.begin(),
+                      pane_handles.end());
+  return grid;
+}
+
+split_tabs::SplitTabLayout GetSplitGridHandleLayout(
+    size_t pane_count,
+    size_t handle,
+    split_tabs::SplitTabLayout layout) {
+  const size_t line_handles =
+      split_tabs::GetSplitGridLines(pane_count).size() - 1;
+  if (handle < line_handles) {
+    return layout;
+  }
+  return IsSideBySide(layout) ? split_tabs::SplitTabLayout::kStacked
+                              : split_tabs::SplitTabLayout::kSideBySide;
+}
+
+void ResizeSplitGrid(const SplitGrid& start,
+                     size_t handle,
+                     int amount,
+                     int min_pane_size,
+                     int snap_distance,
+                     split_tabs::SplitTabVisualData& visual_data) {
+  const bool side_by_side = IsSideBySide(visual_data.split_layout());
+  const std::vector<int> lines =
+      split_tabs::GetSplitGridLines(start.panes.size());
+  const std::vector<size_t> first_panes = GetFirstPanes(lines);
+
+  // The shares when the drag began.
+  std::vector<double> line_sizes;
+  std::vector<double> pane_ratios;
+  for (size_t line = 0; line < lines.size(); ++line) {
+    const gfx::Rect& first = start.panes[first_panes[line]];
+    line_sizes.push_back(MainSize(first, side_by_side));
+    double pane_ratio = 0.5;
+    if (lines[line] == 2) {
+      const gfx::Rect& second = start.panes[first_panes[line] + 1];
+      pane_ratio = static_cast<double>(CrossSize(first, side_by_side)) /
+                   (CrossSize(first, side_by_side) +
+                    CrossSize(second, side_by_side));
+    }
+    pane_ratios.push_back(pane_ratio);
+  }
+
+  // The new size of the first of two neighbours, snapped to half of both.
+  auto resize = [&](double first, double second) {
+    const double both = first + second;
+    const double min_size = std::min<double>(min_pane_size, both / 2);
+    const double new_first =
+        std::clamp(first + amount, min_size, both - min_size);
+    return std::abs(new_first - both / 2) < snap_distance ? both / 2
+                                                          : new_first;
+  };
+
+  const size_t line_handles = lines.size() - 1;
+  if (handle < line_handles) {
+    const double new_first =
+        resize(line_sizes[handle], line_sizes[handle + 1]);
+    line_sizes[handle + 1] += line_sizes[handle] - new_first;
+    line_sizes[handle] = new_first;
+  } else {
+    // The handle of the n-th line of two panes.
+    size_t pane_handle = handle - line_handles;
+    for (size_t line = 0; line < lines.size(); ++line) {
+      if (lines[line] != 2) {
+        continue;
+      }
+      if (pane_handle-- > 0) {
+        continue;
+      }
+      const double first =
+          CrossSize(start.panes[first_panes[line]], side_by_side);
+      const double second =
+          CrossSize(start.panes[first_panes[line] + 1], side_by_side);
+      pane_ratios[line] = resize(first, second) / (first + second);
+      break;
+    }
+  }
+
+  const double total =
+      std::accumulate(line_sizes.begin(), line_sizes.end(), 0.0);
+  std::vector<double> line_ratios;
+  for (double size : line_sizes) {
+    line_ratios.push_back(size / total);
+  }
+  visual_data.set_grid_ratios(std::move(line_ratios), std::move(pane_ratios));
+}
+
+SplitGridCorners GetSplitGridCorners(size_t pane_count,
+                                     size_t index,
+                                     split_tabs::SplitTabLayout layout) {
+  const std::vector<int> lines = split_tabs::GetSplitGridLines(pane_count);
+  const std::vector<size_t> first_panes = GetFirstPanes(lines);
+  size_t line = 0;
+  while (line + 1 < lines.size() && first_panes[line + 1] <= index) {
+    ++line;
+  }
+  const bool first_line = line == 0;
+  const bool last_line = line == lines.size() - 1;
+  const bool first_in_line = index == first_panes[line];
+  const bool last_in_line = index == first_panes[line] + lines[line] - 1;
+
+  // Side by side, lines are columns of panes from top to bottom; stacked,
+  // rows of panes from left to right.
+  if (IsSideBySide(layout)) {
+    return {.top_left = first_line && first_in_line,
+            .top_right = last_line && first_in_line,
+            .bottom_left = first_line && last_in_line,
+            .bottom_right = last_line && last_in_line};
+  }
+  return {.top_left = first_line && first_in_line,
+          .top_right = first_line && last_in_line,
+          .bottom_left = last_line && first_in_line,
+          .bottom_right = last_line && last_in_line};
+}
+
