+void TabStripModel::ResplitImpl(split_tabs::SplitTabId split_id,
+                                const std::vector<tabs::TabInterface*>& tabs,
+                                split_tabs::SplitTabVisualData visual_data) {
+  CHECK_GE(tabs.size(), 2u);
+  if (contents_data_->GetSplitTabCollection(split_id)) {
+    RemoveSplitImpl(split_id,
+                    SplitTabChange::SplitTabRemoveReason::kSplitTabUpdated);
+  }
+
+  // Line the tabs up from the first one in the strip, keeping its group and
+  // pinned state: the tabs already placed are never moved again.
+  tabs::TabInterface* const first_tab = *std::ranges::min_element(
+      tabs, {}, [this](tabs::TabInterface* tab) { return GetIndexOfTab(tab); });
+  const int start_index = GetIndexOfTab(first_tab);
+  const std::optional<tab_groups::TabGroupId> group = first_tab->GetGroup();
+  const bool pinned = first_tab->IsPinned();
+  std::vector<int> indices;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    const int index = start_index + static_cast<int>(i);
+    MoveTabToIndexImpl(GetIndexOfTab(tabs[i]), index, group, pinned,
+                       /*select_after_move=*/false);
+    indices.push_back(index);
+  }
+
+  AddToSplitImpl(split_id, indices, start_index, visual_data,
+                 SplitTabChange::SplitTabAddReason::kSplitTabUpdated);
+}
+
+void TabStripModel::KeepPanesLeft(tabs::TabInterface* leaving_tab) {
+  const split_tabs::SplitTabId split_id = leaving_tab->GetSplit().value();
+  const std::vector<tabs::TabInterface*> split_tabs =
+      GetSplitData(split_id)->ListTabs();
+  if (split_tabs.size() <= 2) {
+    return;
+  }
+  ShrunkSplit shrunk_split(split_id);
+  for (tabs::TabInterface* tab : split_tabs) {
+    if (tab != leaving_tab) {
+      shrunk_split.tabs.push_back(tab->GetHandle());
+    }
+  }
+  shrunk_split.visual_data = *GetSplitData(split_id)->visual_data();
+  shrunk_split.visual_data.set_grid_ratios({}, {});
+  shrunk_splits_.push_back(std::move(shrunk_split));
+}
+
+void TabStripModel::KeepPanesLeftOnMove(
+    int index,
+    int to_position,
+    const std::optional<tab_groups::TabGroupId>& group,
+    bool pinned) {
+  tabs::TabInterface* const tab = GetTabAtIndex(index);
+  if (!tab->IsSplit()) {
+    return;
+  }
+  // A move within the grid only reorders it (see MoveTabToIndexImpl()).
+  if (GetTabAtIndex(to_position)->GetSplit() == tab->GetSplit() &&
+      tab->GetGroup() == group && tab->IsPinned() == pinned) {
+    return;
+  }
+  KeepPanesLeft(tab);
+}
+
+void TabStripModel::ResplitShrunkSplits() {
+  if (closing_all_) {
+    shrunk_splits_.clear();
+    return;
+  }
+  for (ShrunkSplit& shrunk_split : std::exchange(shrunk_splits_, {})) {
+    std::vector<tabs::TabInterface*> tabs;
+    for (const tabs::TabHandle& handle : shrunk_split.tabs) {
+      tabs::TabInterface* const tab = handle.Get();
+      if (tab && GetIndexOfTab(tab) != kNoTab && !tab->IsSplit()) {
+        tabs.push_back(tab);
+      }
+    }
+    if (tabs.size() >= 2) {
+      ResplitImpl(shrunk_split.split_id, tabs, shrunk_split.visual_data);
+    }
+  }
+}
