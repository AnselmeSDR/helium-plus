+// The split of the active tab, if `index` can join it.
+std::optional<split_tabs::SplitTabId> GetSplitToJoin(const TabStripModel& model,
+                                                     int index) {
+  const tabs::TabInterface* active_tab = model.GetActiveTab();
+  if (!active_tab || !active_tab->IsSplit() ||
+      model.GetTabAtIndex(index)->IsSplit()) {
+    return std::nullopt;
+  }
+  const split_tabs::SplitTabId split_id = active_tab->GetSplit().value();
+  if (model.GetSplitData(split_id)->ListTabs().size() >=
+      split_tabs::kMaxTabsInSplit) {
+    return std::nullopt;
+  }
+  return split_id;
+}
