+
+#include "ui/gfx/geometry/rect.h"
+
+namespace split_tabs {
+enum class SplitTabLayout;
+class SplitTabVisualData;
+}  // namespace split_tabs
+
+namespace helium_plus {
+
+// A split of more than two tabs, shown as a grid of lines (columns side by
+// side, rows when stacked) of one or two panes, see
+// split_tabs::GetSplitGridLines(). Handles go between the lines first, then
+// between the two panes of each line.
+struct SplitGrid {
+  SplitGrid();
+  SplitGrid(const SplitGrid&);
+  SplitGrid& operator=(const SplitGrid&);
+  ~SplitGrid();
+
+  // In tab order.
+  std::vector<gfx::Rect> panes;
+  std::vector<gfx::Rect> handles;
+};
+
+// The grid of `pane_count` panes in `bounds`, with the shares of
+// `visual_data`. Panes keep at least `min_pane_size` when there is room.
+SplitGrid CalculateSplitGrid(const gfx::Rect& bounds,
+                             size_t pane_count,
+                             const split_tabs::SplitTabVisualData& visual_data,
+                             int handle_size,
+                             int min_pane_size);
+
+// The orientation of `handle`: kSideBySide for a handle that resizes widths.
+split_tabs::SplitTabLayout GetSplitGridHandleLayout(
+    size_t pane_count,
+    size_t handle,
+    split_tabs::SplitTabLayout layout);
+
+// Updates the shares of `visual_data` for `handle` moved by `amount` pixels
+// from where it was in `start`.
+void ResizeSplitGrid(const SplitGrid& start,
+                     size_t handle,
+                     int amount,
+                     int min_pane_size,
+                     int snap_distance,
+                     split_tabs::SplitTabVisualData& visual_data);
+
+// Which corners of the grid pane `index` takes.
+struct SplitGridCorners {
+  bool top_left = false;
+  bool top_right = false;
+  bool bottom_left = false;
+  bool bottom_right = false;
+};
+SplitGridCorners GetSplitGridCorners(size_t pane_count,
+                                     size_t index,
+                                     split_tabs::SplitTabLayout layout);
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_SPLIT_GRID_LAYOUT_H_
