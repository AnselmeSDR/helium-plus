+  split_tabs.insert(at_start ? split_tabs.begin() : split_tabs.end(),
+                    added_tabs.begin(), added_tabs.end());
+
+  // The grid changes shape: its panes start with equal sizes.
+  split_tabs::SplitTabVisualData visual_data =
+      *GetSplitData(split_id)->visual_data();
+  visual_data.set_grid_ratios({}, {});
+  ResplitImpl(split_id, split_tabs, visual_data);
+}
+
+void TabStripModel::UpdateSplitGridRatios(split_tabs::SplitTabId split_id,
+                                          std::vector<double> line_ratios,
+                                          std::vector<double> pane_ratios,
+                                          bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  split_tabs::SplitTabData* split_data = GetSplitData(split_id);
+  if (split_data->visual_data()->line_ratios() == line_ratios &&
+      split_data->visual_data()->pane_ratios() == pane_ratios) {
+    return;
+  }
+
+  split_tabs::SplitTabVisualData old_visual_data = *split_data->visual_data();
+  split_data->visual_data()->set_grid_ratios(std::move(line_ratios),
+                                             std::move(pane_ratios));
+
+  NotifySplitTabVisualsChanged(
+      split_id, old_visual_data, *split_data->visual_data(),
+      SplitTabChange::SplitVisualChangeReason::kRatioUpdated, is_intermediate);
+}
+
+void TabStripModel::SwapTabsInSplit(split_tabs::SplitTabId split_id,
+                                    size_t first,
+                                    size_t second) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+
+  std::vector<tabs::TabInterface*> split_tabs =
+      GetSplitData(split_id)->ListTabs();
+  CHECK_LT(first, split_tabs.size());
+  CHECK_LT(second, split_tabs.size());
+  if (first == second) {
+    return;
+  }
+  std::swap(split_tabs[first], split_tabs[second]);
+  ResplitImpl(split_id, split_tabs, *GetSplitData(split_id)->visual_data());
+}
