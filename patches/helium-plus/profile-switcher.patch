+class ProfileSwitcherView::SwipeHandler : public ui::EventHandler {
+ public:
+  SwipeHandler(BrowserWindowInterface* browser, views::View* swipe_area)
+      : browser_(browser), swipe_area_(swipe_area) {
+    swipe_area_->AddPreTargetHandler(this);
+  }
+  SwipeHandler(const SwipeHandler&) = delete;
+  SwipeHandler& operator=(const SwipeHandler&) = delete;
+  ~SwipeHandler() override { swipe_area_->RemovePreTargetHandler(this); }
+
+  // ui::EventHandler:
+  void OnScrollEvent(ui::ScrollEvent* event) override {
+    // Chromium's swipe between focused tab groups takes precedence.
+    if (base::FeatureList::IsEnabled(features::kTabGroupsFocusing)) {
+      return;
+    }
+    if (event->type() == ui::EventType::kScrollFlingStart ||
+        event->type() == ui::EventType::kScrollFlingCancel) {
+      ConsumeIfSwiping(event);
+      Reset();
+      return;
+    }
+    // Momentum scrolling never switches profile.
+    if (event->momentum_phase() != ui::EventMomentumPhase::NONE) {
+      ConsumeIfSwiping(event);
+      if (event->momentum_phase() == ui::EventMomentumPhase::END) {
+        Reset();
+      }
+      return;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (event->scroll_event_phase() == ui::ScrollEventPhase::kBegan ||
+        now - g_last_switch_gesture_event > kGestureResetTimeout) {
+      g_last_switch_gesture_event = base::TimeTicks();
+    }
+    if (!g_last_switch_gesture_event.is_null()) {
+      g_last_switch_gesture_event = now;
+      event->SetHandled();
+      return;
+    }
+    if (event->scroll_event_phase() == ui::ScrollEventPhase::kBegan ||
+        (!last_event_time_.is_null() &&
+         now - last_event_time_ > kGestureResetTimeout)) {
+      Reset();
+    }
+    last_event_time_ = now;
+    if (event->scroll_event_phase() == ui::ScrollEventPhase::kEnd) {
+      ConsumeIfSwiping(event);
+      Reset();
+      return;
+    }
+    ProcessOffset(event);
+  }
+
+ private:
+  enum class State { kNone, kHorizontal, kVertical };
+
+  void ProcessOffset(ui::ScrollEvent* event) {
+    if (state_ == State::kVertical) {
+      return;
+    }
+    cumulative_x_ += event->x_offset();
+    cumulative_y_ += event->y_offset();
+    if (state_ == State::kNone) {
+      if (std::abs(cumulative_y_) >= kAxisLockThreshold &&
+          std::abs(cumulative_y_) > std::abs(cumulative_x_)) {
+        state_ = State::kVertical;
+        return;
+      }
+      if (std::abs(cumulative_x_) >= kAxisLockThreshold &&
+          std::abs(cumulative_x_) > std::abs(cumulative_y_)) {
+        state_ = State::kHorizontal;
+      }
+    }
+    if (state_ != State::kHorizontal) {
+      return;
+    }
+    ConsumeIfSwiping(event);
+    if (std::abs(cumulative_x_) >= kSwipeThreshold) {
+      // Fingers moving left show the next profile, like Arc.
+      const bool forward = cumulative_x_ < 0;
+      Reset();
+      g_last_switch_gesture_event = base::TimeTicks::Now();
+      SwitchToAdjacentProfile(browser_, forward);
+    }
+  }
+
+  void ConsumeIfSwiping(ui::Event* event) {
+    if (state_ == State::kHorizontal) {
+      event->SetHandled();
+      event->StopPropagation();
+    }
+  }
+
+  void Reset() {
+    state_ = State::kNone;
+    cumulative_x_ = 0.0f;
+    cumulative_y_ = 0.0f;
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<views::View> swipe_area_;
+  State state_ = State::kNone;
+  float cumulative_x_ = 0.0f;
+  float cumulative_y_ = 0.0f;
+  base::TimeTicks last_event_time_;
+};
+
+ProfileSwitcherView::ProfileSwitcherView(
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller,
+    views::View* swipe_area)
+    : browser_(browser) {
+  // The buttons keep their size (see UpdateButtonSizes()): with flex, a long
+  // tab list would squash them to make room.
+  if (!browser_->GetProfile()->IsRegularProfile()) {
+    SetVisible(false);
+    return;
+  }
+  swipe_handler_ = std::make_unique<SwipeHandler>(browser_, swipe_area);
+  OnCollapseChanged(state_controller->GetCollapseState());
+  collapse_subscription_ =
+      state_controller->RegisterOnCollapseChanged(base::BindRepeating(
+          &ProfileSwitcherView::OnCollapseChanged, base::Unretained(this)));
+  storage_observation_.Observe(
+      &g_browser_process->profile_manager()->GetProfileAttributesStorage());
+  Rebuild();
+}
+
+ProfileSwitcherView::~ProfileSwitcherView() = default;
+
+// static
+void ProfileSwitcherView::AddToTabStrip(
+    views::View* parent,
+    BrowserWindowInterface* browser,
+    tabs::VerticalTabStripStateController* state_controller,
+    views::View* swipe_area,
+    const gfx::Insets& margins) {
+  // Takes the space left below the tabs (after the new tab button, when shown)
+  // and gives it back first when they need it.
+  parent->AddChildView(std::make_unique<views::View>())
+      ->SetProperty(
+          views::kFlexBehaviorKey,
+          views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                   views::MaximumFlexSizeRule::kUnbounded)
+              .WithOrder(2));
+  parent
+      ->AddChildView(std::make_unique<ProfileSwitcherView>(
+          browser, state_controller, swipe_area))
+      ->SetProperty(views::kMarginsKey, margins);
+}
+
+void ProfileSwitcherView::Rebuild() {
+  RemoveAllChildViews();
+  const std::vector<ProfileAttributesEntry*> profiles = GetSwitchableProfiles();
+  SetVisible(profiles.size() > 1);
+  if (!GetVisible()) {
+    return;
+  }
+
+  const base::FilePath& current = browser_->GetProfile()->GetPath();
+  for (ProfileAttributesEntry* entry : profiles) {
+    const base::FilePath path = entry->GetPath();
+    auto button = std::make_unique<ProfileButton>(
+        base::BindRepeating(
+            [](BrowserWindowInterface* browser, const base::FilePath& path) {
+              SwitchToProfile(browser, path);
+            },
+            browser_, path),
+        path, path == current);
+    button->SetTooltipText(entry->GetName());
+    button->GetViewAccessibility().SetName(entry->GetName());
+    AddChildView(std::move(button));
+  }
+  button_size_ = 0;
+  UpdateButtonSizes();
+}
+
+void ProfileSwitcherView::UpdateButtonSizes() {
+  if (children().empty()) {
+    return;
+  }
+  // Expanded strip: the buttons share its width instead of overflowing it.
+  int button_size =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripCollapseButtonSize);
+  if (GetOrientation() == views::LayoutOrientation::kHorizontal) {
+    button_size = std::clamp(width() / static_cast<int>(children().size()),
+                             kMinButtonSize, button_size);
+  }
+  if (button_size == button_size_) {
+    return;
+  }
+  button_size_ = button_size;
+  const int icon_size = std::min(
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripButtonIconSize),
+      button_size - 2 * kIconPadding);
+  for (views::View* child : children()) {
+    static_cast<ProfileButton*>(child)->SetSizes(button_size, icon_size);
+  }
+}
+
+void ProfileSwitcherView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::FlexLayoutView::OnBoundsChanged(previous_bounds);
+  UpdateButtonSizes();
+}
+
+void ProfileSwitcherView::OnCollapseChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  // Stacked vertically when the tab strip is collapsed to icons.
+  const bool expanded = state == tabs::VerticalTabStripCollapseState::kExpanded;
+  SetOrientation(expanded ? views::LayoutOrientation::kHorizontal
+                          : views::LayoutOrientation::kVertical);
+  SetMainAxisAlignment(expanded ? views::LayoutAlignment::kCenter
+                                : views::LayoutAlignment::kEnd);
+  SetCrossAxisAlignment(expanded ? views::LayoutAlignment::kEnd
+                                 : views::LayoutAlignment::kCenter);
+  button_size_ = 0;
+  UpdateButtonSizes();
+}
+
+void ProfileSwitcherView::OnProfileAdded(const base::FilePath&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileWasRemoved(const base::FilePath&,
+                                              const std::u16string&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileNameChanged(const base::FilePath&,
+                                               const std::u16string&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileAvatarChanged(const base::FilePath&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileHighResAvatarLoaded(const base::FilePath&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileIsOmittedChanged(const base::FilePath&) {
+  Rebuild();
+}
+
+void ProfileSwitcherView::OnProfileThemeColorsChanged(const base::FilePath&) {
+  Rebuild();
+}
