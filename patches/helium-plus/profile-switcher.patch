+  ProfileSwitcherView& operator=(const ProfileSwitcherView&) = delete;
+  ~ProfileSwitcherView() override;
+
+  // Adds the icons at the end of `parent`, the vertical tab strip content,
+  // below an empty space that keeps them at the bottom while the tabs do not
+  // need it.
+  static void AddToTabStrip(
+      views::View* parent,
+      BrowserWindowInterface* browser,
+      tabs::VerticalTabStripStateController* state_controller,
+      views::View* swipe_area,
+      const gfx::Insets& margins);
+
+ private:
+  class SwipeHandler;
+
+  void Rebuild();
