+BrowserWindowInterface* FindLastActiveWindow(Profile* profile) {
+  BrowserWindowInterface* found = nullptr;
+  ProfileBrowserCollection::GetForProfile(profile)->ForEach(
+      [&found](BrowserWindowInterface* browser) {
+        if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        found = browser;
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return found;
+}
+
+void ShowInPlaceOf(BrowserWindowInterface* from, BrowserWindowInterface* to) {
+  if (from == to) {
+    return;
+  }
+  ui::BaseWindow* from_window = from->GetWindow();
+  ui::BaseWindow* to_window = to->GetWindow();
+  // Fullscreen windows live in their own space: only swap regular windows.
+  const bool swap = !from_window->IsFullscreen() && !to_window->IsFullscreen();
+  if (swap) {
+    to_window->SetBounds(from_window->GetBounds());
+  }
+  // Same tab strip width and collapse state, as if it were the same window.
+  auto* from_strip = tabs::VerticalTabStripStateController::From(from);
+  auto* to_strip = tabs::VerticalTabStripStateController::From(to);
+  if (from_strip && to_strip) {
+    to_strip->SetUncollapsedWidth(from_strip->GetUncollapsedWidth());
+    if (to_strip->IsCollapsed() != from_strip->IsCollapsed()) {
+      to_strip->RequestCollapse(from_strip->IsCollapsed());
+    }
+  }
+  if (to_window->IsMinimized()) {
+    to_window->Restore();
+  }
+  to_window->Show();
+  if (swap) {
+    from_window->Hide();
+  }
+}
+
+}  // namespace
+
+std::vector<ProfileAttributesEntry*> GetSwitchableProfiles() {
+  std::vector<ProfileAttributesEntry*> profiles =
+      g_browser_process->profile_manager()
+          ->GetProfileAttributesStorage()
+          .GetAllProfilesAttributesSortedForDisplay();
+  std::erase_if(profiles, [](ProfileAttributesEntry* entry) {
+    return entry->IsOmitted();
+  });
+  return profiles;
+}
+
+void SwitchToProfile(BrowserWindowInterface* from, const base::FilePath& path) {
+  if (path == from->GetProfile()->GetPath()) {
+    return;
+  }
+  Profile* profile =
+      g_browser_process->profile_manager()->GetProfileByPath(path);
+  if (BrowserWindowInterface* to =
+          profile ? FindLastActiveWindow(profile) : nullptr) {
+    ShowInPlaceOf(from, to);
+    return;
+  }
+  profiles::SwitchToProfile(path, /*always_create=*/false,
+                            base::BindOnce(
+                                [](base::WeakPtr<BrowserWindowInterface> from,
+                                   BrowserWindowInterface* to) {
+                                  if (from && to) {
+                                    ShowInPlaceOf(from.get(), to);
+                                  }
+                                },
+                                from->GetWeakPtr()));
+}
+
+void SwitchToAdjacentProfile(BrowserWindowInterface* from, bool forward) {
+  const std::vector<ProfileAttributesEntry*> profiles = GetSwitchableProfiles();
+  const base::FilePath& current = from->GetProfile()->GetPath();
+  auto it =
+      std::ranges::find(profiles, current, &ProfileAttributesEntry::GetPath);
+  if (it == profiles.end()) {
+    return;
+  }
+  // Like Arc, no wrapping around past the first or last profile.
+  if (forward ? std::next(it) == profiles.end() : it == profiles.begin()) {
+    return;
+  }
+  SwitchToProfile(from,
+                  (*(forward ? std::next(it) : std::prev(it)))->GetPath());
+}
+
+bool ShowHiddenBrowserWindow() {
+  BrowserWindowInterface* hidden = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&hidden](BrowserWindowInterface* browser) {
+        ui::BaseWindow* window = browser->GetWindow();
+        if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+            window->IsVisible() || window->IsMinimized()) {
+          return true;
+        }
+        hidden = browser;
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  if (!hidden) {
+    return false;
+  }
+  hidden->GetWindow()->Show();
+  return true;
+}
+
+}  // namespace helium_plus
