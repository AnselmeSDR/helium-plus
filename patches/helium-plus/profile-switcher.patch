+// Same feel as Chromium's swipe between focused tab groups
+// (VerticalTabStripFocusSwipeController).
+constexpr float kAxisLockThreshold = 15.0f;
+constexpr float kSwipeThreshold = 75.0f;
+constexpr base::TimeDelta kGestureResetTimeout = base::Milliseconds(300);
+
+// The gesture that switched profile goes on over the window shown in its
+// place: it must not switch again.
+base::TimeTicks g_last_switch_gesture_event;
+
+// Smallest button, below it the icons shrink (narrow tab strip).
+constexpr int kMinButtonSize = 20;
+// Space between an icon and the edge of its button.
+constexpr int kIconPadding = 3;
+// The other profiles are dimmed, shown in full when hovered.
+constexpr float kInactiveOpacity = 0.45f;
+
+// Icon shown instead of the avatar, like an Arc space icon: its name is stored
+// under this key in the profile's Local State entry (profile.info_cache).
+constexpr char kProfileIconKey[] = "helium_plus_icon";
+
+struct NamedIcon {
+  std::string_view name;
+  raw_ref<const gfx::VectorIcon> icon;
+};
+
+const gfx::VectorIcon* GetProfileIcon(const base::FilePath& path) {
+  static const NamedIcon kIcons[] = {
+      {"code", raw_ref(vector_icons::kCodeIcon)},
+      {"computer", raw_ref(vector_icons::kDesktopWindowsIcon)},
+      {"game", raw_ref(vector_icons::kVideogameAssetIcon)},
+      {"home", raw_ref(vector_icons::kHomeIcon)},
+      {"work", raw_ref(vector_icons::kWorkIcon)},
+  };
+  const base::DictValue* entry = g_browser_process->local_state()
+                                     ->GetDict(prefs::kProfileAttributes)
+                                     .FindDict(path.BaseName().AsUTF8Unsafe());
+  const std::string* name =
+      entry ? entry->FindString(kProfileIconKey) : nullptr;
+  if (!name) {
+    return nullptr;
+  }
+  for (const NamedIcon& icon : kIcons) {
+    if (icon.name == *name) {
+      return &*icon.icon;
+    }
+  }
+  return nullptr;
+}
+
+// One profile: the current one in a pill, the others dimmed until hovered.
+class ProfileButton : public views::ImageButton {
+  METADATA_HEADER(ProfileButton, views::ImageButton)
+
+ public:
+  ProfileButton(PressedCallback callback,
+                const base::FilePath& path,
+                bool current)
+      : views::ImageButton(std::move(callback)),
+        path_(path),
+        current_(current) {
+    SetImageHorizontalAlignment(ALIGN_CENTER);
+    SetImageVerticalAlignment(ALIGN_MIDDLE);
+    ConfigureInkDrop(this);
+    if (current_) {
+      SetBackground(views::CreateRoundedRectBackground(
+          ui::kColorSysPrimary,
+          GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+      return;
+    }
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetOpacity(kInactiveOpacity);
+  }
+
+  void SetSizes(int button_size, int icon_size) {
+    ProfileAttributesEntry* entry = g_browser_process->profile_manager()
+                                        ->GetProfileAttributesStorage()
+                                        .GetProfileAttributesWithPath(path_);
+    if (!entry) {
+      return;
+    }
+    const gfx::VectorIcon* icon = GetProfileIcon(path_);
+    const ui::ColorId icon_color =
+        current_ ? ui::ColorId{ui::kColorSysOnPrimary}
+                 : ui::ColorId{kColorTabForegroundInactiveFrameActive};
+    SetImageModel(
+        STATE_NORMAL,
+        icon ? ui::ImageModel::FromVectorIcon(*icon, icon_color, icon_size)
+             : ui::ImageModel::FromImage(profiles::GetSizedAvatarIcon(
+                   entry->GetAvatarIcon(icon_size), icon_size, icon_size,
+                   profiles::SHAPE_CIRCLE)));
+    SetPreferredSize(gfx::Size(button_size, button_size));
+  }
+
+ protected:
+  // views::ImageButton:
+  void StateChanged(ButtonState old_state) override {
+    views::ImageButton::StateChanged(old_state);
+    if (!current_) {
+      layer()->SetOpacity(GetState() == STATE_NORMAL ? kInactiveOpacity : 1.0f);
+    }
+  }
+
+ private:
+  const base::FilePath path_;
+  const bool current_;
+};
