+#ifndef CHROME_BROWSER_UI_HELIUM_PLUS_TAB_IMPORT_H_
+#define CHROME_BROWSER_UI_HELIUM_PLUS_TAB_IMPORT_H_
+
+#include <set>
+
+#include "base/files/file_path.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+
+namespace helium_plus {
+
+// Recreates tabs from a plan, e.g. Arc spaces converted by an import script.
+// With --helium-plus-import=<dir>, the first window of each profile gets the
+// tabs of <dir>/<profile directory name>.json, unloaded like restored tabs:
+//   {"pinned": [tab, ...],
+//    "groups": [{"title": ..., "color": "blue", "collapsed": true,
+//                "tabs": [tab, ...]}, ...],
+//    "tabs": [tab, ...]}
+// where a tab is {"url": ..., "title": ..., "name": custom title (optional)}.
+// Pinned and grouped tabs are anchored to their URL and closed, like Arc's
+// pinned tabs that are not open. The plan is then renamed to .json.done so that
+// it is imported only once.
+class TabImport : public BrowserCollectionObserver {
+ public:
+  static void EnsureStarted();
+
+  TabImport(const TabImport&) = delete;
+  TabImport& operator=(const TabImport&) = delete;
+
+ private:
+  friend class base::NoDestructor<TabImport>;
+
+  explicit TabImport(base::FilePath dir);
+  ~TabImport() override;
+
+  void MaybeImport(BrowserWindowInterface* browser);
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+
+  const base::FilePath dir_;
+  std::set<base::FilePath> handled_profiles_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+};
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_HELIUM_PLUS_TAB_IMPORT_H_
