+namespace {
+
+constexpr char kImportSwitch[] = "helium-plus-import";
+
+// Leaves time for session restore to fill the window first.
+constexpr base::TimeDelta kImportDelay = base::Seconds(2);
+
+tab_groups::TabGroupColorId GetColor(const std::string* name) {
+  static constexpr auto kColors =
+      base::MakeFixedFlatMap<std::string_view, tab_groups::TabGroupColorId>({
+          {"grey", tab_groups::TabGroupColorId::kGrey},
+          {"blue", tab_groups::TabGroupColorId::kBlue},
+          {"red", tab_groups::TabGroupColorId::kRed},
+          {"yellow", tab_groups::TabGroupColorId::kYellow},
+          {"green", tab_groups::TabGroupColorId::kGreen},
+          {"pink", tab_groups::TabGroupColorId::kPink},
+          {"purple", tab_groups::TabGroupColorId::kPurple},
+          {"cyan", tab_groups::TabGroupColorId::kCyan},
+          {"orange", tab_groups::TabGroupColorId::kOrange},
+      });
+  const auto it = name ? kColors.find(*name) : kColors.end();
+  return it != kColors.end() ? it->second : tab_groups::TabGroupColorId::kGrey;
+}
+
+std::optional<base::DictValue> ReadPlan(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+}
+
+void AddTab(BrowserWindowInterface* browser,
+            const base::Value& tab,
+            int index,
+            std::optional<tab_groups::TabGroupId> group,
+            bool pin) {
+  const std::string* url_spec =
+      tab.is_dict() ? tab.GetDict().FindString("url") : nullptr;
+  const GURL url = url_spec ? GURL(*url_spec) : GURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  const std::string* title = tab.GetDict().FindString("title");
+  const std::string* name = tab.GetDict().FindString("name");
+
+  std::unique_ptr<content::NavigationEntry> entry =
+      content::NavigationController::CreateNavigationEntry(
+          url, content::Referrer(), std::nullopt, std::nullopt,
+          ui::PAGE_TRANSITION_AUTO_BOOKMARK, false, std::string(),
+          browser->GetProfile(), /*blob_url_loader_factory=*/nullptr);
+  if (title) {
+    entry->SetTitle(base::UTF8ToUTF16(*title));
+  }
+  const sessions::SerializedNavigationEntry navigation =
+      sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+          0, entry.get());
+
+  std::map<std::string, std::string> extra_data;
+  if (pin || group) {
+    extra_data[kAnchorUrlKey] = url.spec();
+    if (title) {
+      extra_data[kAnchorTitleKey] = *title;
+    }
+    extra_data[kClosedKey] = "1";
+  }
+  if (name && !name->empty()) {
+    extra_data[kCustomTitleKey] = *name;
+  }
+
+  chrome::AddRestoredTab(
+      browser, base::span_from_ref(navigation), index,
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(), group,
+      /*select=*/false, pin, base::TimeTicks(), base::Time(),
+      /*session_storage_namespace=*/nullptr,
+      sessions::SerializedUserAgentOverride(), extra_data,
+      /*from_session_restore=*/true, /*is_active_browser=*/std::nullopt,
+      chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+}
+
+void ImportPlan(base::WeakPtr<BrowserWindowInterface> browser,
+                const base::FilePath& path,
+                std::optional<base::DictValue> plan) {
+  if (!browser || !plan) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+
+  if (const base::ListValue* pinned = plan->FindList("pinned")) {
+    for (const base::Value& tab : *pinned) {
+      AddTab(browser.get(), tab, model->IndexOfFirstNonPinnedTab(),
+             std::nullopt, /*pin=*/true);
+    }
+  }
+
+  if (const base::ListValue* groups = plan->FindList("groups")) {
+    for (const base::Value& group : *groups) {
+      const base::ListValue* tabs =
+          group.is_dict() ? group.GetDict().FindList("tabs") : nullptr;
+      if (!tabs) {
+        continue;
+      }
+      const tab_groups::TabGroupId id = tab_groups::TabGroupId::GenerateNew();
+      for (const base::Value& tab : *tabs) {
+        AddTab(browser.get(), tab, model->count(), id, /*pin=*/false);
+      }
+      if (!model->group_model()->ContainsTabGroup(id)) {
+        continue;
+      }
+      const std::string* title = group.GetDict().FindString("title");
+      model->ChangeTabGroupVisuals(
+          id, tab_groups::TabGroupVisualData(
+                  title ? base::UTF8ToUTF16(*title) : std::u16string(),
+                  GetColor(group.GetDict().FindString("color")),
+                  group.GetDict().FindBool("collapsed").value_or(true)));
+    }
+  }
+
+  if (const base::ListValue* tabs = plan->FindList("tabs")) {
+    for (const base::Value& tab : *tabs) {
+      AddTab(browser.get(), tab, model->count(), std::nullopt, /*pin=*/false);
+    }
+  }
+
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(base::IgnoreResult(&base::Move), path,
+                     path.AddExtensionASCII("done")));
+}
+
+}  // namespace
+
+// static
+void TabImport::EnsureStarted() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kImportSwitch)) {
+    return;
+  }
+  static base::NoDestructor<TabImport> import(
+      command_line.GetSwitchValuePath(kImportSwitch));
+}
+
+TabImport::TabImport(base::FilePath dir) : dir_(std::move(dir)) {
+  GlobalBrowserCollection* browsers = GlobalBrowserCollection::GetInstance();
+  browser_collection_observation_.Observe(browsers);
+  browsers->ForEach([this](BrowserWindowInterface* browser) {
+    MaybeImport(browser);
+    return true;
+  });
+}
+
+TabImport::~TabImport() = default;
+
+void TabImport::MaybeImport(BrowserWindowInterface* browser) {
+  Profile* profile = browser->GetProfile();
+  if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !profile->IsRegularProfile() ||
+      !handled_profiles_.insert(profile->GetPath()).second) {
+    return;
+  }
+  const base::FilePath plan =
+      dir_.Append(profile->GetBaseName()).AddExtensionASCII("json");
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             const base::FilePath& plan) {
+            base::ThreadPool::PostTaskAndReplyWithResult(
+                FROM_HERE, {base::MayBlock()}, base::BindOnce(&ReadPlan, plan),
+                base::BindOnce(&ImportPlan, browser, plan));
+          },
+          browser->GetWeakPtr(), plan),
+      kImportDelay);
+}
+
+void TabImport::OnBrowserCreated(BrowserWindowInterface* browser) {
+  MaybeImport(browser);
+}
+
+}  // namespace helium_plus
