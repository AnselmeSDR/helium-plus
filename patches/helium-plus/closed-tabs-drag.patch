+    for (const ClosedTabs* list :
+         {&state->closed_before(), &state->closed_after()}) {
+      for (const ClosedTab& closed_tab : *list) {
+        closed_tabs.emplace(closed_tab.id, closed_tab);
+      }
+    }
+  }
+  if (!model) {
+    return;
+  }
