+void TabGroupView::OnTabsDropped() {
+  // Helium+: the dropped tab keeps its place among the closed tabs.
+  if (!LaysOutDragPosition()) {
+    return;
+  }
+  std::vector<helium_plus::ClosedTabsService::DisplayItem> order;
+  bool has_closed_tabs = false;
+  auto add_tab = [&order](const views::View& view) {
+    const TabView* tab_view = views::AsViewClass<TabView>(&view);
+    if (const tabs::TabInterface* tab =
+            tab_view ? tab_view->GetTabInterface() : nullptr) {
+      order.emplace_back(tab->GetHandle());
+    }
+  };
+  for (const views::ChildLayout& layout : GetLayoutForDrag().child_layouts) {
+    const views::View* child = layout.child_view;
+    if (const auto* closed_tab_view =
+            views::AsViewClass<helium_plus::ClosedTabView>(child)) {
+      if (layout.visible) {
+        order.emplace_back(closed_tab_view->closed_tab_id());
+        has_closed_tabs = true;
+      }
+    } else if (views::IsViewClass<SplitTabView>(child)) {
+      for (const views::View* split_child : child->children()) {
+        add_tab(*split_child);
+      }
+    } else {
+      add_tab(*child);
+    }
+  }
+  if (has_closed_tabs) {
+    helium_plus::ClosedTabsService::Arrange(order);
+  }
+}
+
+bool TabGroupView::KeepsDraggedTabs() const {
+  if (!closed_tab_views_) {
+    return false;
+  }
+  bool has_closed_tabs = false;
+  for (const views::View* child : GetDisplayedChildren()) {
+    if (views::IsViewClass<helium_plus::ClosedTabView>(child)) {
+      has_closed_tabs = true;
+    } else if (!GetDragHandler().IsViewDragging(*child)) {
+      return false;
+    }
+  }
+  return has_closed_tabs;
+}
