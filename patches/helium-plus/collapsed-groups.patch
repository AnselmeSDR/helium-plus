+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_GROUP_TABS_POPOVER_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_GROUP_TABS_POPOVER_H_
+
+#include <memory>
+
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "components/tabs/public/tab_interface.h"
