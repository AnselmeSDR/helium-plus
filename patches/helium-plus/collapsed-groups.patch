+
+class TabGroupView;
+
+namespace views {
+class BubbleDialogDelegate;
+}
+
+namespace helium_plus {
+
+// Like Arc, hovering the header of a collapsed vertical tab group shows a
+// popover listing all its tabs, closed ones included; clicking one activates
+// it. The popover closes once the mouse leaves the header and the popover.
+class GroupTabsPopover : public views::MouseWatcherListener {
+ public:
+  explicit GroupTabsPopover(TabGroupView& group_view);
+  GroupTabsPopover(const GroupTabsPopover&) = delete;
+  GroupTabsPopover& operator=(const GroupTabsPopover&) = delete;
+  ~GroupTabsPopover() override;
+
+  // Shows the popover after a short delay if the header is still hovered.
+  void OnHeaderHovered();
+  void Hide();
+
+ private:
+  class Host;
+
+  void Show();
+  void ActivateTab(tabs::TabHandle tab);
+  void OnClosed(views::Widget::ClosedReason reason);
+
+  // views::MouseWatcherListener:
+  void MouseMovedOutOfHost() override;
+
+  const raw_ref<TabGroupView> group_view_;
+  base::OneShotTimer show_timer_;
+  std::unique_ptr<views::BubbleDialogDelegate> delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  std::unique_ptr<views::MouseWatcher> mouse_watcher_;
+  base::WeakPtrFactory<GroupTabsPopover> weak_factory_{this};
+};
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_GROUP_TABS_POPOVER_H_
