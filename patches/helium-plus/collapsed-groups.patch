+
+namespace helium_plus {
+
+namespace {
+
+constexpr base::TimeDelta kShowDelay = base::Milliseconds(300);
+constexpr int kPopoverWidth = 280;
+constexpr int kPopoverMaxHeight = 480;
+// Space between the tab strip and the popover.
+constexpr int kStripGap = 8;
+
+// Returns the header row widened to the whole tab strip, plus the gap.
+gfx::Rect GetAnchorRect(const views::View& header) {
+  gfx::Rect rect = header.GetBoundsInScreen();
+  for (const views::View* view = &header; view; view = view->parent()) {
+    if (views::IsViewClass<VerticalTabStripRegionView>(view)) {
+      const gfx::Rect strip = view->GetBoundsInScreen();
+      rect.set_x(strip.x());
+      rect.set_width(strip.width());
+      break;
+    }
+  }
+  rect.Outset(gfx::Outsets::VH(0, kStripGap));
+  return rect;
+}
+
+}  // namespace
+
+// Keeps the popover open while the mouse is over it, or over the header row
+// up to the popover.
+class GroupTabsPopover::Host : public views::MouseWatcherHost {
+ public:
+  explicit Host(GroupTabsPopover& popover) : popover_(popover) {}
+
+  // views::MouseWatcherHost:
+  bool Contains(const gfx::Point& screen_point, EventType type) override {
+    if (!popover_->widget_) {
+      return false;
+    }
+    const gfx::Rect popover_bounds =
+        popover_->widget_->GetWindowBoundsInScreen();
+    const gfx::Rect header_bounds =
+        popover_->group_view_->group_header()->GetBoundsInScreen();
+    const int left = std::min(popover_bounds.x(), header_bounds.x());
+    const int right = std::max(popover_bounds.right(), header_bounds.right());
+    const gfx::Rect header_row(left, header_bounds.y(), right - left,
+                               header_bounds.height());
+    return popover_bounds.Contains(screen_point) ||
+           header_row.Contains(screen_point);
+  }
+
+ private:
+  const raw_ref<GroupTabsPopover> popover_;
+};
+
+GroupTabsPopover::GroupTabsPopover(TabGroupView& group_view)
+    : group_view_(group_view) {}
+
+GroupTabsPopover::~GroupTabsPopover() = default;
+
+void GroupTabsPopover::OnHeaderHovered() {
+  if (widget_) {
+    return;
+  }
+  show_timer_.Start(
+      FROM_HERE, kShowDelay,
+      base::BindOnce(&GroupTabsPopover::Show, base::Unretained(this)));
+}
+
+void GroupTabsPopover::Hide() {
+  show_timer_.Stop();
+  if (mouse_watcher_) {
+    mouse_watcher_->Stop();
+  }
+  if (widget_ && !widget_->IsClosed()) {
+    widget_->CloseWithReason(views::Widget::ClosedReason::kUnspecified);
+  }
+}
+
+void GroupTabsPopover::Show() {
+  TabGroupHeaderView* header = group_view_->group_header();
+  const TabCollectionNode* node = group_view_->collection_node();
+  if (widget_ || !node || !group_view_->IsCollapsed() ||
+      !header->IsMouseHovered() || !header->GetWidget()) {
+    return;
+  }
+
+  auto tab_list = std::make_unique<views::View>();
+  tab_list->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  for (const views::View* child : node->GetDirectChildren()) {
+    const TabView* tab_view = views::AsViewClass<TabView>(child);
+    const tabs::TabInterface* tab =
+        tab_view ? tab_view->GetTabInterface() : nullptr;
+    if (!tab) {
+      continue;
+    }
+    tab_list->AddChildView(std::make_unique<HoverButton>(
+        base::BindRepeating(&GroupTabsPopover::ActivateTab,
+                            weak_factory_.GetWeakPtr(), tab->GetHandle()),
+        tab_view->data().favicon, tab_view->data().title));
+  }
+  if (tab_list->children().empty()) {
+    return;
+  }
+  auto contents = std::make_unique<views::ScrollView>();
+  contents->SetContents(std::move(tab_list));
+  contents->ClipHeightTo(0, kPopoverMaxHeight);
+  contents->SetHorizontalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kDisabled);
+  // Opaque, as the tab titles use subpixel text rendering.
+  contents->SetBackgroundColor(ui::kColorBubbleBackground);
+
+  // Opens away from the window edge the tab strip is on.
+  const bool strip_on_right =
+      header->GetBoundsInScreen().CenterPoint().x() >
+      header->GetWidget()->GetWindowBoundsInScreen().CenterPoint().x();
+  delegate_ = std::make_unique<views::BubbleDialogDelegate>(
+      nullptr, strip_on_right ? views::BubbleBorder::RIGHT_TOP
+                              : views::BubbleBorder::LEFT_TOP);
+  delegate_->SetAnchorRect(GetAnchorRect(*header));
+  delegate_->set_parent_window(header->GetWidget()->GetNativeView());
+  delegate_->SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+  delegate_->SetShowCloseButton(false);
+  delegate_->SetShowTitle(false);
+  delegate_->SetCanActivate(false);
+  delegate_->set_margins(gfx::Insets::VH(4, 0));
+  delegate_->set_fixed_width(kPopoverWidth);
+  delegate_->SetContentsView(std::move(contents));
+
+  widget_ = views::BubbleDialogDelegate::CreateBubble(
+      delegate_.get(), base::BindOnce(&GroupTabsPopover::OnClosed,
+                                      weak_factory_.GetWeakPtr()));
+  widget_->ShowInactive();
+
+  mouse_watcher_ =
+      std::make_unique<views::MouseWatcher>(std::make_unique<Host>(*this), this);
+  mouse_watcher_->Start(header->GetWidget()->GetNativeWindow());
+}
+
+void GroupTabsPopover::ActivateTab(tabs::TabHandle handle) {
+  Hide();
+  tabs::TabInterface* tab = handle.Get();
+  if (!tab) {
+    return;
+  }
+  TabStripModel* model = tab->GetBrowserWindowInterface()->GetTabStripModel();
+  const int index = model->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    model->ActivateTabAt(index);
+  }
+}
+
+void GroupTabsPopover::OnClosed(views::Widget::ClosedReason reason) {
+  mouse_watcher_.reset();
+  // The widget is still closing: delete it, then its delegate, later.
+  auto task_runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+  task_runner->DeleteSoon(FROM_HERE, std::move(widget_));
+  task_runner->DeleteSoon(FROM_HERE, std::move(delegate_));
+}
+
+void GroupTabsPopover::MouseMovedOutOfHost() {
+  Hide();
+}
+
+}  // namespace helium_plus
