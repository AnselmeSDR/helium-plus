+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_plus/shared_settings.h"
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace helium_plus {
+
+namespace {
+
+// Last value of each shared setting, keyed by pref name (none: default value).
+constexpr char kSharedSettingsPref[] = "helium_plus.shared_settings";
+
+// Settings pages: Helium, appearance, startup, privacy, site settings,
+// performance, search engine, languages, downloads, accessibility.
+constexpr std::string_view kSharedPrefixes[] = {
+    "helium.",
+    "vertical_tabs.",
+    "browser.theme.",
+    "intl.",
+    "spellcheck.",
+    "performance_tuning.",
+    "profile.default_content_setting_values.",
+    "settings.a11y.",
+    "accessibility.captions.",
+};
+// Profile state under the prefixes above, not settings.
+constexpr std::string_view kNotSharedPrefixes[] = {
+    "helium.private_sync.",
+    "settings.a11y.read_anything.",
+};
+constexpr std::string_view kSharedNames[] = {
+    "bookmark_bar.show_on_all_tabs",
+    "bookmark_bar.show_tab_groups",
+    "bookmark_bar.visibility_state",
+    "bookmark_bar.show_apps_shortcut",
+    "side_panel.is_right_aligned",
+    "webkit.webprefs.default_font_size",
+    "webkit.webprefs.default_fixed_font_size",
+    "webkit.webprefs.minimum_font_size",
+    "webkit.webprefs.fonts.standard.Zyyy",
+    "webkit.webprefs.fonts.serif.Zyyy",
+    "webkit.webprefs.fonts.sansserif.Zyyy",
+    "webkit.webprefs.fonts.fixed.Zyyy",
+    "browser.show_home_button",
+    "homepage",
+    "homepage_is_newtabpage",
+    "session.restore_on_startup",
+    "session.startup_urls",
+    "toolbar.pinned_actions",
+    "ntp.shortcust_visible",
+    "ntp.custom_links_visible",
+    "default_search_provider_data.template_url_data",
+    "omnibox.prevent_url_elisions",
+    "browser.enable_spellchecking",
+    "translate.enabled",
+    "translate_blocked_languages",
+    "translate_allowlists",
+    "profile.cookie_controls_mode",
+    "https_only_mode_enabled",
+    "enable_do_not_track",
+    "net.network_prediction_options",
+    "safebrowsing.enabled",
+    "safebrowsing.enhanced",
+    "credentials_enable_service",
+    "credentials_enable_autosignin",
+    "autofill.profile_enabled",
+    "autofill.credit_card_enabled",
+    "download.default_directory",
+    "download.prompt_for_download",
+    "savefile.default_directory",
+};
+
+bool IsSharedSetting(std::string_view name) {
+  if (std::ranges::find(kSharedNames, name) != std::ranges::end(kSharedNames)) {
+    return true;
+  }
+  const auto starts_with = [name](std::string_view prefix) {
+    return base::StartsWith(name, prefix);
+  };
+  return std::ranges::any_of(kSharedPrefixes, starts_with) &&
+         std::ranges::none_of(kNotSharedPrefixes, starts_with);
+}
+
+// The value to share: none when the setting is at its default.
+base::Value GetSharedValue(const PrefService::Preference& pref) {
+  return pref.HasUserSetting() ? pref.GetValue()->Clone() : base::Value();
+}
+
+void ApplySharedValue(PrefService* prefs,
+                      const std::string& name,
+                      const base::Value& value) {
+  const PrefService::Preference* pref = prefs->FindPreference(name);
+  if (!pref || !pref->IsUserModifiable() || GetSharedValue(*pref) == value) {
+    return;
+  }
+  if (value.is_none()) {
+    prefs->ClearPref(name);
+  } else {
+    prefs->Set(name, value);
+  }
+}
+
+}  // namespace
+
+// static
+void SharedSettings::RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kSharedSettingsPref);
+}
+
+// static
+void SharedSettings::EnsureStarted() {
+  static base::NoDestructor<SharedSettings> shared_settings;
+}
+
+SharedSettings::SharedSettings() {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  profile_manager_observation_.Observe(profile_manager);
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    AddProfile(profile);
+  }
+}
+
+SharedSettings::~SharedSettings() = default;
+
+void SharedSettings::AddProfile(Profile* profile) {
+  if (!profile->IsRegularProfile() || registrars_.contains(profile)) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  std::vector<std::string> names;
+  prefs->IteratePreferenceValues(base::BindRepeating(
+      [](std::vector<std::string>* names, const std::string& name,
+         const base::Value&) {
+        if (IsSharedSetting(name)) {
+          names->push_back(name);
+        }
+      },
+      &names));
+
+  // The values shared by the other profiles win; a setting no profile has
+  // shared yet takes this profile's value.
+  {
+    ScopedDictPrefUpdate update(g_browser_process->local_state(),
+                                kSharedSettingsPref);
+    for (const std::string& name : names) {
+      const PrefService::Preference* pref = prefs->FindPreference(name);
+      if (!pref->IsUserModifiable()) {
+        continue;
+      }
+      if (const base::Value* shared = update->Find(name)) {
+        ApplySharedValue(prefs, name, *shared);
+      } else {
+        update->Set(name, GetSharedValue(*pref));
+      }
+    }
+  }
+
+  auto registrar = std::make_unique<PrefChangeRegistrar>();
+  registrar->Init(prefs);
+  for (const std::string& name : names) {
+    registrar->Add(name,
+                   base::BindRepeating(&SharedSettings::OnSettingChanged,
+                                       base::Unretained(this), profile, name));
+  }
+  registrars_[profile] = std::move(registrar);
+  profile_observations_.AddObservation(profile);
+}
+
+void SharedSettings::OnSettingChanged(Profile* profile,
+                                      const std::string& name) {
+  const PrefService::Preference* pref =
+      profile->GetPrefs()->FindPreference(name);
+  if (!pref || !pref->IsUserModifiable()) {
+    return;
+  }
+  base::Value value = GetSharedValue(*pref);
+  PrefService* local_state = g_browser_process->local_state();
+  // Also reached when applying the shared value to the other profiles.
+  if (const base::Value* shared =
+          local_state->GetDict(kSharedSettingsPref).Find(name);
+      shared && *shared == value) {
+    return;
+  }
+  ScopedDictPrefUpdate(local_state, kSharedSettingsPref)
+      ->Set(name, value.Clone());
+  for (const auto& [other, registrar] : registrars_) {
+    if (other != profile) {
+      ApplySharedValue(other->GetPrefs(), name, value);
+    }
+  }
+}
+
+void SharedSettings::OnProfileAdded(Profile* profile) {
+  AddProfile(profile);
+}
+
+void SharedSettings::OnProfileManagerDestroying() {
+  profile_observations_.RemoveAllObservations();
+  registrars_.clear();
+  profile_manager_observation_.Reset();
+}
+
+void SharedSettings::OnProfileWillBeDestroyed(Profile* profile) {
+  profile_observations_.RemoveObservation(profile);
+  registrars_.erase(profile);
+}
+
+}  // namespace helium_plus
