 // static
+bool ClosedTabsService::ReopenLastClosed(TabStripModel& model,
+                                         base::Time closed_after) {
+  base::Time last = closed_after;
+  std::optional<int> last_index;
+  std::optional<int> last_id;
+  for (int index = 0; index < model.count(); ++index) {
+    const TabState* state = TabState::From(model.GetTabAtIndex(index));
+    if (!state) {
+      continue;
+    }
+    if (state->IsClosed() && state->closed_time() > last) {
+      last = state->closed_time();
+      last_index = index;
+      last_id.reset();
+    }
+    for (const ClosedTabs* closed_tabs :
+         {&state->closed_before(), &state->closed_after()}) {
+      for (const ClosedTab& closed_tab : *closed_tabs) {
+        if (closed_tab.closed_time > last) {
+          last = closed_tab.closed_time;
+          last_id = closed_tab.id;
+          last_index.reset();
+        }
+      }
+    }
+  }
+  if (last_id) {
+    return Restore(model, *last_id, /*select=*/true).has_value();
+  }
+  if (last_index) {
+    // Activating a closed tab opens it again.
+    model.ActivateTabAt(*last_index);
+    return true;
+  }
+  return false;
+}
+
+// static
+bool ClosedTabsService::HasReopenableTab(TabStripModel& model) {
+  for (int index = 0; index < model.count(); ++index) {
+    const TabState* state = TabState::From(model.GetTabAtIndex(index));
+    if (!state) {
+      continue;
+    }
+    if (state->IsClosed() && !state->closed_time().is_null()) {
+      return true;
+    }
+    for (const ClosedTabs* closed_tabs :
+         {&state->closed_before(), &state->closed_after()}) {
+      if (std::ranges::any_of(*closed_tabs, [](const ClosedTab& closed_tab) {
+            return !closed_tab.closed_time.is_null();
+          })) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
