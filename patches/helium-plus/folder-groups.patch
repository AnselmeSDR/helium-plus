+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_FOLDER_ICON_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_FOLDER_ICON_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace views {
+class Background;
+class ImageView;
+class Label;
+}  // namespace views
+
+namespace helium_plus {
+
+// Like in Arc and Dia, a group of the vertical tab strip looks like a folder:
+// this icon then its name, without a colored chip. The icon is a folder in the
+// group color, open while the group is expanded.
+class FolderIconView : public views::View {
+  METADATA_HEADER(FolderIconView, views::View)
+
+ public:
+  FolderIconView();
+  FolderIconView(const FolderIconView&) = delete;
+  FolderIconView& operator=(const FolderIconView&) = delete;
+  ~FolderIconView() override;
+
+  void SetFolder(SkColor color, bool collapsed);
+
+ private:
+  raw_ptr<views::ImageView> folder_ = nullptr;
+};
+
+// Styles the header of a folder: `icon` then `name`.
+void StyleFolderHeader(views::View& icon, views::Label& name);
+
+// Colors of a folder header of the tab strip of `view`: its name, and its
+// background with a discreet border, transparent unless `highlighted` (hovered
+// or edited).
+SkColor GetFolderTextColor(const views::View& view);
+std::unique_ptr<views::Background> CreateFolderBackground(
+    const views::View& view,
+    bool highlighted,
+    float corner_radius);
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_PLUS_FOLDER_ICON_VIEW_H_
