+
+#include "chrome/browser/ui/views/helium_plus/folder_icon_view.h"
+
+#include <memory>
+
+#include "chrome/browser/ui/tabs/tab_style.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/painter.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+namespace helium_plus {
+
+namespace {
+
+constexpr int kIconSize = 16;
+constexpr int kIconNamePadding = 8;
+// Opacity of the border of a folder header, from the color of its name.
+constexpr SkAlpha kBorderAlpha = 0x26;
+
+bool IsFrameActive(const views::View& view) {
+  return !view.GetWidget() || view.GetWidget()->ShouldPaintAsActive();
+}
+
+}  // namespace
+
+FolderIconView::FolderIconView() {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  SetPreferredSize(gfx::Size(kIconSize, kIconSize));
+  SetCanProcessEventsWithinSubtree(false);
+  folder_ = AddChildView(std::make_unique<views::ImageView>());
+}
+
+FolderIconView::~FolderIconView() = default;
+
+void FolderIconView::SetFolder(SkColor color, bool collapsed) {
+  folder_->SetImage(
+      ui::ImageModel::FromVectorIcon(collapsed ? vector_icons::kFolderFilledIcon
+                                               : vector_icons::kFolderOpenIcon,
+                                     color, kIconSize));
+}
+
+void StyleFolderHeader(views::View& icon, views::Label& name) {
+  icon.SetProperty(views::kMarginsKey,
+                   gfx::Insets::TLBR(0, 0, 0, kIconNamePadding));
+  name.SetFontList(
+      name.font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  // Like tab titles, painted over the tab strip without a background.
+  name.SetSkipSubpixelRenderingOpacityCheck(true);
+}
+
+SkColor GetFolderTextColor(const views::View& view) {
+  return TabStyle::Get()->GetTabForegroundColor(
+      /*apparently_active=*/false, IsFrameActive(view),
+      view.GetColorProvider());
+}
+
+std::unique_ptr<views::Background> CreateFolderBackground(
+    const views::View& view,
+    bool highlighted,
+    float corner_radius) {
+  const SkColor background_color =
+      highlighted
+          ? TabStyle::Get()->GetTabBackgroundColor(
+                TabStyle::TabSelectionState::kInactive,
+                /*hovered=*/true, IsFrameActive(view), view.GetColorProvider())
+          : SK_ColorTRANSPARENT;
+  return views::CreateBackgroundFromPainter(
+      views::Painter::CreateRoundRectWith1PxBorderPainter(
+          background_color, SkColorSetA(GetFolderTextColor(view), kBorderAlpha),
+          corner_radius));
+}
+
+BEGIN_METADATA(FolderIconView)
+END_METADATA
+
+}  // namespace helium_plus
