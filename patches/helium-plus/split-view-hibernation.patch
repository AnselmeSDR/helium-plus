+  void OnSplitTabChanged(const SplitTabChange& change) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (change.type != SplitTabChange::Type::kVisualsChanged) {
+      UpdateSplitTabs(change.model);
+    }
+  }
+
+  // Helium+: the tabs of the active tab's split are shown with it, so they are
+  // active tabs too. Otherwise one could be discarded and leave its pane blank.
+  void UpdateSplitTabs(TabStripModel* tab_strip_model) {
+    if (tab_strip_model->empty()) {
+      return;
+    }
+    const std::vector<tabs::TabInterface*> foreground_tabs =
+        tab_strip_model->GetForegroundTabs();
+    for (int i = 0; i < tab_strip_model->count(); ++i) {
+      tabs::TabInterface* tab = tab_strip_model->GetTabAtIndex(i);
+      PageLiveStateDecorator::SetIsActiveTab(
+          tab->GetContents(), std::ranges::contains(foreground_tabs, tab));
+    }
+  }
