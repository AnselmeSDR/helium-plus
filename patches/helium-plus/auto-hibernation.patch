+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_PLUS_HIBERNATION_SERVICE_H_
+#define CHROME_BROWSER_UI_HELIUM_PLUS_HIBERNATION_SERVICE_H_
+
+#include <map>
+#include <memory>
+#include <set>
+
+#include "base/memory/memory_pressure_listener.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tab_groups/tab_group_id.h"
+
+class Profile;
+
+namespace helium_plus {
+
+// Puts tabs to sleep on its own: tabs of a group collapsed for a while, tabs of
+// a profile left in the background for a while, and one tab at a time while
+// the system is low on memory. Tabs left inactive are handled by Memory Saver.
+class HibernationService : public BrowserCollectionObserver,
+                           public TabStripModelObserver,
+                           public base::MemoryPressureListener {
+ public:
+  static void EnsureStarted();
+
+  HibernationService(const HibernationService&) = delete;
+  HibernationService& operator=(const HibernationService&) = delete;
+
+ private:
+  friend class base::NoDestructor<HibernationService>;
+
+  struct GroupTimer {
+    raw_ptr<TabStripModel> model;
+    base::OneShotTimer timer;
+  };
+
+  HibernationService();
+  ~HibernationService() override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+
+  // base::MemoryPressureListener:
+  void OnMemoryPressure(base::MemoryPressureLevel level) override;
+
+  void Observe(TabStripModel* model);
+  void HibernateProfile(Profile* profile);
+  void HibernateGroup(tab_groups::TabGroupId group);
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  std::set<raw_ptr<TabStripModel>> observed_models_;
+  std::map<raw_ptr<Profile>, std::unique_ptr<base::OneShotTimer>>
+      profile_timers_;
+  std::map<tab_groups::TabGroupId, std::unique_ptr<GroupTimer>> group_timers_;
+  base::MemoryPressureListenerRegistration memory_pressure_registration_;
+  base::TimeTicks last_memory_pressure_discard_;
+};
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_HELIUM_PLUS_HIBERNATION_SERVICE_H_
