+namespace {
+
+// The tabs a command on the tab at `index` applies to.
+std::vector<int> GetIndicesForCommand(const TabStripModel& model, int index) {
+  if (!model.IsTabSelected(index)) {
+    return {index};
+  }
+  std::vector<int> indices;
+  for (int i = 0; i < model.count(); ++i) {
+    if (model.IsTabSelected(i)) {
+      indices.push_back(i);
+    }
+  }
+  return indices;
+}
+
+class MoveToProfileMenuModel : public ui::SimpleMenuModel,
+                               public ui::SimpleMenuModel::Delegate {
+ public:
+  MoveToProfileMenuModel(TabStripModel& model,
+                         int index,
+                         const std::vector<ProfileAttributesEntry*>& profiles)
+      : ui::SimpleMenuModel(this), model_(model), index_(index) {
+    for (ProfileAttributesEntry* entry : profiles) {
+      paths_.push_back(entry->GetPath());
+      // Command ids from 1.
+      AddItem(static_cast<int>(paths_.size()), entry->GetName());
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id < 1 || command_id > static_cast<int>(paths_.size()) ||
+        !model_->ContainsIndex(index_)) {
+      return;
+    }
+    MoveTabsToProfile(*model_, GetIndicesForCommand(*model_, index_),
+                      paths_[command_id - 1]);
+  }
+
+ private:
+  const raw_ref<TabStripModel> model_;
+  const int index_;
+  std::vector<base::FilePath> paths_;
+};
+
+struct MovedTab {
+  GURL url;
+  std::u16string custom_title;
+  tabs::TabHandle handle;
+};
+
+// Once the window of the other profile shows: the tabs open there, then close
+// here.
+void OpenMovedTabs(std::vector<MovedTab> moved_tabs, BrowserWindowInterface* to) {
+  if (!to) {
+    return;
+  }
+  bool first = true;
+  for (const MovedTab& moved : moved_tabs) {
+    content::WebContents* contents = chrome::AddAndReturnTabAt(
+        to, moved.url, /*index=*/-1, /*foreground=*/first,
+        /*group=*/std::nullopt, /*pinned=*/false,
+        NavigateParams::WindowAction::kNoAction);
+    first = false;
+    tabs::TabInterface* tab =
+        contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+    TabState* state = tab ? TabState::From(tab) : nullptr;
+    if (state && !moved.custom_title.empty()) {
+      state->SetCustomTitle(moved.custom_title);
+    }
+  }
+  for (const MovedTab& moved : moved_tabs) {
+    tabs::TabInterface* tab = moved.handle.Get();
+    BrowserWindowInterface* browser =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (!browser) {
+      continue;
+    }
+    TabStripModel* model = browser->GetTabStripModel();
+    const int index = model->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      // Moved, not closed: nothing to reopen here.
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+    }
+  }
+}
+
+}  // namespace
+
+void AddMoveToProfileMenu(ui::SimpleMenuModel& menu,
+                          TabStripModel& model,
+                          int index,
+                          std::unique_ptr<ui::SimpleMenuModel>& submenu) {
+  if (!model.ContainsIndex(index) || model.profile()->IsOffTheRecord()) {
+    return;
+  }
+  std::vector<ProfileAttributesEntry*> profiles = GetSwitchableProfiles();
+  std::erase_if(profiles, [&model](ProfileAttributesEntry* entry) {
+    return entry->GetPath() == model.profile()->GetPath();
+  });
+  if (profiles.empty()) {
+    return;
+  }
+  submenu = std::make_unique<MoveToProfileMenuModel>(model, index, profiles);
+  menu.AddSubMenu(tabs::CommandMoveToProfile,
+                  GetString(StringId::kMoveToProfile), submenu.get());
+}
+
+void MoveTabsToProfile(TabStripModel& model,
+                       const std::vector<int>& indices,
+                       const base::FilePath& path) {
+  std::vector<MovedTab> moved_tabs;
+  BrowserWindowInterface* from = nullptr;
+  for (int index : indices) {
+    if (!model.ContainsIndex(index)) {
+      continue;
+    }
+    tabs::TabInterface* tab = model.GetTabAtIndex(index);
+    content::WebContents* contents = tab->GetContents();
+    if (!contents) {
+      continue;
+    }
+    // Also for a hibernated tab, not loaded.
+    const content::NavigationEntry* entry =
+        contents->GetController().GetLastCommittedEntry();
+    const GURL url = entry && !entry->GetURL().is_empty()
+                         ? entry->GetURL()
+                         : contents->GetVisibleURL();
+    const TabState* state = TabState::From(tab);
+    moved_tabs.push_back(
+        {url, state ? state->custom_title() : std::u16string(),
+         tab->GetHandle()});
+    from = tab->GetBrowserWindowInterface();
+  }
+  if (!from || moved_tabs.empty()) {
+    return;
+  }
+  SwitchToProfile(from, path,
+                  base::BindOnce(&OpenMovedTabs, std::move(moved_tabs)));
+}
+
