+// Like Arc, the windows of a profile show the same tabs: opening, closing,
+// moving, pinning, grouping or splitting a tab in one window does the same in
+// the others, each window keeping its own copy of the pages (loaded when
+// shown) and its own active tab. A navigation reaches the copies in the other
+// windows the next time they are shown, never while they are on screen.
+//
+// The first window of a profile is its main window: the only one saved with
+// the session and whose groups are saved tab groups. The other windows are
+// replicas, built again from the main window when they open. Each window also
+// has a slot of the profile switcher: switching profiles shows the window of
+// the other profile in the same slot (see helium_plus/profile_switcher.h).
+class ReplicaWindows : public BrowserCollectionObserver,
+                       public TabStripModelObserver {
+ public:
+  static void EnsureStarted();
+
+  // Whether `browser` is a replica window: not saved with the session.
+  static bool IsReplicaWindow(BrowserWindowInterface* browser);
+  // Whether `group` is a group of a replica window: not a saved tab group.
+  static bool IsReplicaGroup(const tab_groups::TabGroupId& group);
+  // The group of the main window `group` is a copy of, or `group` itself.
+  static tab_groups::TabGroupId GetMainGroup(
+      const tab_groups::TabGroupId& group);
+
+  // When the user closes the main window of a profile having other windows,
+  // hides it instead, as its tabs live on in the other windows. Returns
+  // whether the window was hidden.
+  static bool HideInsteadOfClosing(BrowserWindowInterface* browser);
+  // Whether the tabs of `browser`, closing, live on in other windows: the tab
+  // restore service doesn't record them then.
+  static bool TabsLiveOn(BrowserWindowInterface* browser);
+
+  // The slot of `browser` in the profile switcher.
+  static int GetSlot(BrowserWindowInterface* browser);
+  static void SetSlot(BrowserWindowInterface* browser, int slot);
+  // The normal window of `profile` in `slot`, visible or not.
+  static BrowserWindowInterface* FindWindowInSlot(Profile* profile, int slot);
+  // Opens, not shown yet, a window of `profile` in `slot` with the tabs of
+  // the other windows of `profile`. Returns null if `profile` has no window.
+  static BrowserWindowInterface* CreateWindowInSlot(Profile* profile,
+                                                    int slot,
+                                                    const gfx::Rect& bounds);
+
+  // Before `browser`, hidden, is shown: its copies of pages that navigated in
+  // other windows get the new pages.
+  static void PrepareToShow(BrowserWindowInterface* browser);
+
+  // From TabState.
+  static void OnTabStateChanged(tabs::TabInterface* tab);
+  static void OnNavigationFinished(tabs::TabInterface* tab,
+                                   content::NavigationHandle* handle);
+
+  ReplicaWindows(const ReplicaWindows&) = delete;
+  ReplicaWindows& operator=(const ReplicaWindows&) = delete;
+
+ private:
+  friend class base::NoDestructor<ReplicaWindows>;
+
+  struct WindowState {
+    WindowState();
+    WindowState(WindowState&&);
+    WindowState& operator=(WindowState&&);
+    ~WindowState();
+
+    raw_ptr<BrowserWindowInterface> browser;
+    int slot = 0;
+    // Whether the window got the tabs of the other windows.
+    bool seeded = false;
+    // Its tab strip is closing all its tabs.
+    bool closing = false;
+    // Increased on each structural change made by the user in this window.
+    int structure_version = 0;
+    // Tabs moved out to another window since the last sync.
+    std::set<int> moved_out;
+  };
+
+  struct ProfileState {
+    ProfileState();
+    ProfileState(ProfileState&&);
+    ProfileState& operator=(ProfileState&&);
+    ~ProfileState();
+
+    // In opening order.
+    std::vector<WindowState> windows;
+    raw_ptr<BrowserWindowInterface> main_window;
+    // The main window, closed by the user while other windows remained.
+    bool main_window_hidden_on_close = false;
+    // The tabs of the shared list as of the last sync.
+    std::set<int> synced_ids;
+    // Tabs whose Helium+ state changed, with the window where it did.
+    std::map<int, raw_ptr<BrowserWindowInterface>> changed_states;
+    // Tabs that navigated, with the window where they did.
+    std::map<int, raw_ptr<BrowserWindowInterface>> navigated;
+    // Copies to update once no longer shown, with the window of the tab
+    // that navigated.
+    std::map<tabs::TabHandle, raw_ptr<BrowserWindowInterface>> stale;
+    bool sync_pending = false;
+  };
+
+  static ReplicaWindows* Get();
+
+  ReplicaWindows();
+  ~ReplicaWindows() override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+  void OnSplitTabChanged(const SplitTabChange& change) override;
+  void WillCloseAllTabs(TabStripModel* model) override;
+  void CloseAllTabsStopped(TabStripModel* model,
+                           CloseAllStoppedReason reason) override;
+
+  // Adds `browser` if it is a normal window. Returns its state.
+  WindowState* Register(BrowserWindowInterface* browser);
+  ProfileState* GetProfileState(Profile* profile);
+  WindowState* GetWindowState(BrowserWindowInterface* browser);
+  WindowState* GetWindowState(TabStripModel* model);
+  ProfileState* GetProfileState(TabStripModel* model);
+
+  // A change of the tab list made in `model`, not by this class.
+  void OnListChanged(TabStripModel* model, bool structural);
+  void ScheduleSync(Profile* profile);
+  void Sync(Profile* profile);
+
+  // The windows of `state` taking part in the sync.
+  std::vector<WindowState*> GetSyncedWindows(ProfileState& state);
+  // Gives `target` copies of all the tabs of `source`.
+  void Seed(ProfileState& state, WindowState& source, WindowState& target);
+  // Applies the tabs closed, compacted or added since the last sync.
+  void SyncTabSet(ProfileState& state,
+                  const std::vector<WindowState*>& windows);
+  // Gives `target` the order, pinned state, groups and splits of `source`.
+  void SyncStructure(TabStripModel& source, TabStripModel& target);
+  void SyncGroups(TabStripModel& source, TabStripModel& target);
+  void SyncOrder(TabStripModel& source, TabStripModel& target);
+  void SyncSplits(TabStripModel& source, TabStripModel& target);
+  void SyncStates(ProfileState& state,
+                  const std::vector<WindowState*>& windows);
+  void SyncNavigations(ProfileState& state,
+                       const std::vector<WindowState*>& windows);
+  void UpdateStaleCopies(ProfileState& state);
+
+  // Inserts in `target` at `index` a copy of `tab`, not loaded. Returns it.
+  tabs::TabInterface* AddCopy(TabStripModel& target,
+                              tabs::TabInterface& tab,
+                              int index);
+  // Replaces the page of `copy` by a copy of the page of `source`.
+  void ReplacePage(TabStripModel& model,
+                   tabs::TabInterface& copy,
+                   tabs::TabInterface& source);
+  // The group of `target` that is the copy of `source_group`, if any.
+  std::optional<tab_groups::TabGroupId> FindCopyOfGroup(
+      const tab_groups::TabGroupId& source_group,
+      TabStripModel& target);
+  void LinkGroups(const tab_groups::TabGroupId& first,
+                  const tab_groups::TabGroupId& second);
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  std::map<raw_ptr<Profile>, ProfileState> profiles_;
+  // Groups that are copies of one another share a logical id.
+  std::map<tab_groups::TabGroupId, int> group_ids_;
+  int next_group_id_ = 0;
+  int next_slot_ = 0;
+  int next_structure_version_ = 0;
+  // The slot of the next window opened by CreateWindowInSlot().
+  std::optional<int> pending_slot_;
+  // Changes made by this class are not synced back.
+  int applying_ = 0;
+  base::WeakPtrFactory<ReplicaWindows> weak_factory_{this};
+};
