+
+int IdOf(const tabs::TabInterface* tab) {
+  const TabState* state = tab ? TabState::From(tab) : nullptr;
+  return state ? state->replica_id() : 0;
+}
+
+bool IsSharingWindow(BrowserWindowInterface* browser) {
+  return browser &&
+         browser->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         browser->GetProfile() && !browser->GetProfile()->IsOffTheRecord() &&
+         browser->GetTabStripModel();
+}
+
+// Index of the tab `id` in `model`, or TabStripModel::kNoTab.
+int FindTab(const TabStripModel& model, int id) {
+  for (int index = 0; index < model.count(); ++index) {
+    if (IdOf(model.GetTabAtIndex(index)) == id) {
+      return index;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+std::vector<int> ListIds(const TabStripModel& model) {
+  std::vector<int> ids;
+  for (int index = 0; index < model.count(); ++index) {
+    ids.push_back(IdOf(model.GetTabAtIndex(index)));
+  }
+  return ids;
+}
+
+// Whether a tab of `model` keeps the closed tab `id` (helium_plus/closed_tabs.h).
+bool HasClosedTab(const TabStripModel& model, int id) {
+  for (int index = 0; index < model.count(); ++index) {
+    const TabState* state = TabState::From(model.GetTabAtIndex(index));
+    if (!state) {
+      continue;
+    }
+    for (const ClosedTabs* closed_tabs :
+         {&state->closed_before(), &state->closed_after()}) {
+      if (std::ranges::contains(*closed_tabs, id, &ClosedTab::id)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+// A new tab nobody used yet, like the one a new window opens with.
+bool IsUntouchedNewTab(tabs::TabInterface* tab) {
+  content::WebContents* contents = tab->GetContents();
+  if (!contents || contents->GetController().GetEntryCount() > 1) {
+    return false;
+  }
+  const GURL& url = contents->GetVisibleURL();
+  return url.is_empty() || url.IsAboutBlank() ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          (url.host() == chrome::kChromeUINewTabHost ||
+           url.host() == chrome::kChromeUINewTabPageHost));
+}
+
+// Whether `tab` is on screen: active, or in the active split, in a visible
+// window.
+bool IsShown(BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+  ui::BaseWindow* window = browser->GetWindow();
+  if (!window || !window->IsVisible() || window->IsMinimized()) {
+    return false;
+  }
+  tabs::TabInterface* active = browser->GetTabStripModel()->GetActiveTab();
+  return active == tab ||
+         (active && tab->GetSplit() && active->GetSplit() == tab->GetSplit());
+}
+
+std::vector<int> ListSplitIds(const TabStripModel& model,
+                              split_tabs::SplitTabId split) {
+  std::vector<int> ids;
+  if (const split_tabs::SplitTabData* data = model.GetSplitData(split)) {
+    for (tabs::TabInterface* tab : data->ListTabs()) {
+      ids.push_back(IdOf(tab));
+    }
+  }
+  return ids;
+}
+
+// The splits of `model` in tab order.
+std::vector<split_tabs::SplitTabId> ListSplits(const TabStripModel& model) {
+  std::vector<split_tabs::SplitTabId> splits;
+  for (int index = 0; index < model.count(); ++index) {
+    const std::optional<split_tabs::SplitTabId> split =
+        model.GetTabAtIndex(index)->GetSplit();
+    if (split && !std::ranges::contains(splits, *split)) {
+      splits.push_back(*split);
+    }
+  }
+  return splits;
+}
