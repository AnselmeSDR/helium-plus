+const char kGroupIconsKey[] = "helium_plus.group_icons";
+
+// Saved group id → {"icon": library icon name} or {"svg": drawing}, a drawing
+// being {"viewbox": [x, y, width, height], "paths": [path…]}, a path
+// {"d": SVG path data, "fill": bool, "evenodd": bool, "stroke": width (0:
+// none), "cap": SkPaint::Cap, "join": SkPaint::Join}.
+constexpr char kGroupIconsPref[] = "helium_plus.group_icons";
+constexpr char kIconKey[] = "icon";
+constexpr char kSvgKey[] = "svg";
+constexpr char kViewBoxKey[] = "viewbox";
+constexpr char kPathsKey[] = "paths";
+constexpr char kDataKey[] = "d";
+constexpr char kFillKey[] = "fill";
+constexpr char kEvenOddKey[] = "evenodd";
+constexpr char kStrokeKey[] = "stroke";
+constexpr char kCapKey[] = "cap";
+constexpr char kJoinKey[] = "join";
+
+constexpr int kMaxSvgFileSize = 512 * 1024;
+constexpr size_t kMaxSvgPaths = 1000;
+
+// Style of an SVG element, inherited by its children.
+struct SvgStyle {
+  bool fill = true;
+  bool even_odd = false;
+  bool stroke = false;
+  float stroke_width = 1;
+  SkPaint::Cap cap = SkPaint::kButt_Cap;
+  SkPaint::Join join = SkPaint::kMiter_Join;
+  SkMatrix transform;
+};
+
+std::vector<float> ParseNumbers(std::string_view value) {
+  std::vector<float> numbers;
+  for (std::string_view token :
+       base::SplitStringPiece(value, ", \t\r\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    double number;
+    if (!base::StringToDouble(token, &number)) {
+      return {};
+    }
+    numbers.push_back(static_cast<float>(number));
+  }
+  return numbers;
+}
+
+float ParseLength(std::string_view value, float fallback) {
+  value = base::TrimWhitespaceASCII(value, base::TRIM_ALL);
+  if (value.ends_with("px")) {
+    value.remove_suffix(2);
+  }
+  double number;
+  return base::StringToDouble(value, &number) ? static_cast<float>(number)
+                                              : fallback;
+}
+
+SkMatrix ParseTransform(std::string_view value) {
+  SkMatrix matrix;
+  size_t position = 0;
+  while (true) {
+    const size_t open = value.find('(', position);
+    const size_t close = value.find(')', open);
+    if (open == std::string_view::npos || close == std::string_view::npos) {
+      return matrix;
+    }
+    const std::string_view name = base::TrimString(
+        value.substr(position, open - position), ", \t\r\n", base::TRIM_ALL);
+    const std::vector<float> args =
+        ParseNumbers(value.substr(open + 1, close - open - 1));
+    SkMatrix step;
+    if (name == "matrix" && args.size() == 6) {
+      step.setAll(args[0], args[2], args[4], args[1], args[3], args[5], 0, 0,
+                  1);
+    } else if (name == "translate" && !args.empty()) {
+      step.setTranslate(args[0], args.size() > 1 ? args[1] : 0);
+    } else if (name == "scale" && !args.empty()) {
+      step.setScale(args[0], args.size() > 1 ? args[1] : args[0]);
+    } else if (name == "rotate" && args.size() == 3) {
+      step.setRotate(args[0], args[1], args[2]);
+    } else if (name == "rotate" && !args.empty()) {
+      step.setRotate(args[0]);
+    }
+    matrix.preConcat(step);
+    position = close + 1;
+  }
+}
+
+// Returns the value of the `name` property of `element`, from its style
+// attribute or its own attribute.
+std::string GetProperty(const base::Value& element, std::string_view name) {
+  const std::string style =
+      data_decoder::GetXmlElementAttribute(element, "style");
+  for (std::string_view declaration : base::SplitStringPiece(
+           style, ";", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const size_t colon = declaration.find(':');
+    if (colon != std::string_view::npos &&
+        base::TrimWhitespaceASCII(declaration.substr(0, colon),
+                                  base::TRIM_ALL) == name) {
+      return std::string(base::TrimWhitespaceASCII(
+          declaration.substr(colon + 1), base::TRIM_ALL));
+    }
+  }
+  return data_decoder::GetXmlElementAttribute(element, std::string(name));
+}
+
+void ApplyStyle(const base::Value& element, SvgStyle& style) {
+  if (const std::string fill = GetProperty(element, "fill"); !fill.empty()) {
+    style.fill = fill != "none";
+  }
+  if (const std::string rule = GetProperty(element, "fill-rule");
+      !rule.empty()) {
+    style.even_odd = rule == "evenodd";
+  }
+  if (const std::string stroke = GetProperty(element, "stroke");
+      !stroke.empty()) {
+    style.stroke = stroke != "none";
+  }
+  style.stroke_width =
+      ParseLength(GetProperty(element, "stroke-width"), style.stroke_width);
+  const std::string cap = GetProperty(element, "stroke-linecap");
+  if (cap == "butt") {
+    style.cap = SkPaint::kButt_Cap;
+  } else if (cap == "round") {
+    style.cap = SkPaint::kRound_Cap;
+  } else if (cap == "square") {
+    style.cap = SkPaint::kSquare_Cap;
+  }
+  const std::string join = GetProperty(element, "stroke-linejoin");
+  if (join == "miter") {
+    style.join = SkPaint::kMiter_Join;
+  } else if (join == "round") {
+    style.join = SkPaint::kRound_Join;
+  } else if (join == "bevel") {
+    style.join = SkPaint::kBevel_Join;
+  }
+  if (const std::string transform = GetProperty(element, "transform");
+      !transform.empty()) {
+    style.transform.preConcat(ParseTransform(transform));
+  }
+}
+
+// Returns the shape of `element`, if it is a supported one.
+std::optional<SkPath> GetShape(const base::Value& element,
+                               std::string_view tag) {
+  auto number = [&element](const char* name) {
+    return ParseLength(data_decoder::GetXmlElementAttribute(element, name), 0);
+  };
+  if (tag == "path") {
+    return SkParsePath::FromSVGString(
+        data_decoder::GetXmlElementAttribute(element, "d").c_str());
+  }
+  if (tag == "rect") {
+    const SkRect rect = SkRect::MakeXYWH(number("x"), number("y"),
+                                         number("width"), number("height"));
+    float rx = number("rx");
+    float ry = number("ry");
+    rx = rx > 0 ? rx : ry;
+    ry = ry > 0 ? ry : rx;
+    return rx > 0 ? SkPath::RRect(rect, rx, ry) : SkPath::Rect(rect);
+  }
+  if (tag == "circle") {
+    return SkPath::Circle(number("cx"), number("cy"), number("r"));
+  }
+  if (tag == "ellipse") {
+    const float cx = number("cx");
+    const float cy = number("cy");
+    const float rx = number("rx");
+    const float ry = number("ry");
+    return SkPath::Oval(SkRect::MakeLTRB(cx - rx, cy - ry, cx + rx, cy + ry));
+  }
+  if (tag == "line") {
+    return SkPath::Line({number("x1"), number("y1")},
+                        {number("x2"), number("y2")});
+  }
+  if (tag == "polyline" || tag == "polygon") {
+    const std::vector<float> numbers =
+        ParseNumbers(data_decoder::GetXmlElementAttribute(element, "points"));
+    std::vector<SkPoint> points;
+    for (size_t i = 0; i + 1 < numbers.size(); i += 2) {
+      points.push_back({numbers[i], numbers[i + 1]});
+    }
+    return SkPath::Polygon(points, /*isClosed=*/tag == "polygon");
+  }
+  return std::nullopt;
+}
+
+// Adds the drawing of `element` and its children to `paths`.
+void AddPaths(const base::Value& element,
+              SvgStyle style,
+              base::ListValue& paths) {
+  std::string tag;
+  if (!data_decoder::GetXmlElementTagName(element, &tag) ||
+      paths.size() >= kMaxSvgPaths ||
+      GetProperty(element, "display") == "none") {
+    return;
+  }
+  ApplyStyle(element, style);
+  if (tag == "svg" || tag == "g" || tag == "a") {
+    if (const base::ListValue* children =
+            data_decoder::GetXmlElementChildren(element)) {
+      for (const base::Value& child : *children) {
+        AddPaths(child, style, paths);
+      }
+    }
+    return;
+  }
+  std::optional<SkPath> shape = GetShape(element, tag);
+  if (!shape || (!style.fill && !style.stroke)) {
+    return;
+  }
+  const SkPath path = shape->makeTransform(style.transform);
+  paths.Append(base::DictValue()
+                   .Set(kDataKey, SkParsePath::ToSVGString(path).c_str())
+                   .Set(kFillKey, style.fill)
+                   .Set(kEvenOddKey, style.even_odd)
+                   .Set(kStrokeKey, style.stroke ? style.transform.mapRadius(
+                                                       style.stroke_width)
+                                                 : 0.0)
+                   .Set(kCapKey, static_cast<int>(style.cap))
+                   .Set(kJoinKey, static_cast<int>(style.join)));
+}
+
+// Returns the drawing of the SVG document `root`, or nothing if it draws
+// nothing Helium+ supports.
+std::optional<base::DictValue> ParseSvg(const base::Value& root) {
+  if (!data_decoder::IsXmlElementNamed(root, "svg")) {
+    return std::nullopt;
+  }
+  std::vector<float> view_box =
+      ParseNumbers(data_decoder::GetXmlElementAttribute(root, "viewBox"));
+  if (view_box.size() != 4 || view_box[2] <= 0 || view_box[3] <= 0) {
+    view_box = {
+        0, 0,
+        ParseLength(data_decoder::GetXmlElementAttribute(root, "width"), 24),
+        ParseLength(data_decoder::GetXmlElementAttribute(root, "height"), 24)};
+  }
+  base::ListValue paths;
+  AddPaths(root, SvgStyle(), paths);
+  if (paths.empty() || view_box[2] <= 0 || view_box[3] <= 0) {
+    return std::nullopt;
+  }
+  base::ListValue view_box_value;
+  for (float number : view_box) {
+    view_box_value.Append(number);
+  }
+  return base::DictValue()
+      .Set(kViewBoxKey, std::move(view_box_value))
+      .Set(kPathsKey, std::move(paths));
+}
+
+// Draws a drawing from ParseSvg() in a single color, fitted into the image.
+class SvgIconSource : public gfx::CanvasImageSource {
+ public:
+  SvgIconSource(const base::DictValue& svg, SkColor color, int size)
+      : gfx::CanvasImageSource(gfx::Size(size, size)),
+        svg_(svg.Clone()),
+        color_(color) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    const base::ListValue* view_box = svg_.FindList(kViewBoxKey);
+    const base::ListValue* paths = svg_.FindList(kPathsKey);
+    if (!view_box || view_box->size() != 4 || !paths) {
+      return;
+    }
+    const float x =
+        static_cast<float>((*view_box)[0].GetIfDouble().value_or(0));
+    const float y =
+        static_cast<float>((*view_box)[1].GetIfDouble().value_or(0));
+    const float width =
+        static_cast<float>((*view_box)[2].GetIfDouble().value_or(0));
+    const float height =
+        static_cast<float>((*view_box)[3].GetIfDouble().value_or(0));
+    if (width <= 0 || height <= 0) {
+      return;
+    }
+    const float scale =
+        std::min(size().width() / width, size().height() / height);
+    cc::PaintCanvas* paint_canvas = canvas->sk_canvas();
+    paint_canvas->save();
+    paint_canvas->translate((size().width() - width * scale) / 2,
+                            (size().height() - height * scale) / 2);
+    paint_canvas->scale(scale, scale);
+    paint_canvas->translate(-x, -y);
+    for (const base::Value& value : *paths) {
+      const base::DictValue* path_dict = value.GetIfDict();
+      const std::string* data =
+          path_dict ? path_dict->FindString(kDataKey) : nullptr;
+      std::optional<SkPath> path =
+          data ? SkParsePath::FromSVGString(data->c_str()) : std::nullopt;
+      if (!path) {
+        continue;
+      }
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(color_);
+      if (path_dict->FindBool(kFillKey).value_or(false)) {
+        flags.setStyle(cc::PaintFlags::kFill_Style);
+        paint_canvas->drawPath(
+            path->makeFillType(path_dict->FindBool(kEvenOddKey).value_or(false)
+                                   ? SkPathFillType::kEvenOdd
+                                   : SkPathFillType::kWinding),
+            flags);
+      }
+      const float stroke =
+          static_cast<float>(path_dict->FindDouble(kStrokeKey).value_or(0));
+      if (stroke > 0) {
+        flags.setStyle(cc::PaintFlags::kStroke_Style);
+        flags.setStrokeWidth(stroke);
+        flags.setStrokeCap(static_cast<cc::PaintFlags::Cap>(
+            std::clamp(path_dict->FindInt(kCapKey).value_or(0), 0,
+                       static_cast<int>(cc::PaintFlags::kLast_Cap))));
+        flags.setStrokeJoin(static_cast<cc::PaintFlags::Join>(
+            std::clamp(path_dict->FindInt(kJoinKey).value_or(0), 0,
+                       static_cast<int>(cc::PaintFlags::kLast_Join))));
+        paint_canvas->drawPath(*path, flags);
+      }
+    }
+    paint_canvas->restore();
+  }
+
+ private:
+  const base::DictValue svg_;
+  const SkColor color_;
+};
+
+std::optional<std::string> ReadSvgFile(const base::FilePath& path) {
+  std::string svg;
+  if (!base::ReadFileToStringWithMaxSize(path, &svg, kMaxSvgFileSize)) {
+    return std::nullopt;
+  }
+  return svg;
+}
