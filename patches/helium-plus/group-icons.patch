+ui::ImageModel GroupIcons::GetIcon(const tab_groups::TabGroupId& group,
+                                   SkColor color,
+                                   int size) const {
+  const base::DictValue* entry = GetEntry(group);
+  if (!entry) {
+    return ui::ImageModel();
+  }
+  if (const std::string* name = entry->FindString(kIconKey)) {
+    for (const LibraryIcon& library_icon : GetLibrary()) {
+      if (library_icon.name == *name) {
+        return ui::ImageModel::FromVectorIcon(*library_icon.icon, color, size);
+      }
+    }
+  }
+  if (const base::DictValue* svg = entry->FindDict(kSvgKey)) {
+    return ui::ImageModel::FromImageSkia(
+        gfx::CanvasImageSource::MakeImageSkia<SvgIconSource>(*svg, color,
+                                                             size));
+  }
+  return ui::ImageModel();
+}
+
+std::string GroupIcons::GetIconName(const tab_groups::TabGroupId& group) const {
+  const base::DictValue* entry = GetEntry(group);
+  const std::string* name = entry ? entry->FindString(kIconKey) : nullptr;
+  return name ? *name : std::string();
+}
+
+bool GroupIcons::HasSvgIcon(const tab_groups::TabGroupId& group) const {
+  const base::DictValue* entry = GetEntry(group);
+  return entry && entry->FindDict(kSvgKey);
+}
+
+void GroupIcons::SetIconName(const tab_groups::TabGroupId& group,
+                             const std::string& name) {
+  const std::optional<base::Uuid> saved_id = GetSavedId(group);
+  if (!saved_id) {
+    return;
+  }
+  SetEntry(*saved_id, name.empty() ? std::nullopt
+                                   : std::make_optional(base::DictValue().Set(
+                                         kIconKey, name)));
+}
+
+void GroupIcons::ChooseSvgFile(const tab_groups::TabGroupId& group,
+                               gfx::NativeWindow owning_window) {
+  const std::optional<base::Uuid> saved_id = GetSavedId(group);
+  if (!saved_id || select_file_dialog_) {
+    return;
+  }
+  choosing_for_ = saved_id;
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(nullptr));
+  ui::SelectFileDialog::FileTypeInfo file_types;
+  file_types.extensions = {{FILE_PATH_LITERAL("svg")}};
+  select_file_dialog_->SelectFile(ui::SelectFileDialog::SELECT_OPEN_FILE,
+                                  GetString(StringId::kGroupIconSvgFileTitle),
+                                  base::FilePath(), &file_types,
+                                  /*file_type_index=*/1,
+                                  FILE_PATH_LITERAL("svg"), owning_window);
+}
+
+void GroupIcons::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void GroupIcons::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+std::optional<base::Uuid> GroupIcons::GetSavedId(
+    const tab_groups::TabGroupId& group) const {
+  if (!service_) {
+    return std::nullopt;
+  }
+  const std::optional<tab_groups::SavedTabGroup> saved_group =
+      service_->GetGroup(group);
+  return saved_group ? std::make_optional(saved_group->saved_guid())
+                     : std::nullopt;
+}
+
+const base::DictValue* GroupIcons::GetEntry(
+    const tab_groups::TabGroupId& group) const {
+  const std::optional<base::Uuid> saved_id = GetSavedId(group);
+  return saved_id ? profile_->GetPrefs()
+                        ->GetDict(kGroupIconsPref)
+                        .FindDict(saved_id->AsLowercaseString())
+                  : nullptr;
+}
+
+void GroupIcons::SetEntry(const base::Uuid& saved_id,
+                          std::optional<base::DictValue> entry) {
+  {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kGroupIconsPref);
+    if (entry) {
+      update->Set(saved_id.AsLowercaseString(), std::move(*entry));
+    } else {
+      update->Remove(saved_id.AsLowercaseString());
+    }
+  }
+  NotifyChanged();
+}
+
+void GroupIcons::OnSvgFileRead(const base::Uuid& saved_id,
+                               std::optional<std::string> svg) {
+  if (!svg) {
+    return;
+  }
+  if (!data_decoder_) {
+    data_decoder_ = std::make_unique<data_decoder::DataDecoder>();
+  }
+  data_decoder_->ParseXml(
+      *svg, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      base::BindOnce(&GroupIcons::OnSvgParsed, weak_factory_.GetWeakPtr(),
+                     saved_id));
+}
+
+void GroupIcons::OnSvgParsed(const base::Uuid& saved_id,
+                             base::expected<base::Value, std::string> result) {
+  if (!result.has_value()) {
+    return;
+  }
+  std::optional<base::DictValue> svg = ParseSvg(*result);
+  if (!svg) {
+    return;
+  }
+  SetEntry(saved_id, base::DictValue().Set(kSvgKey, std::move(*svg)));
+}
+
+void GroupIcons::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnGroupIconsChanged();
+  }
+}
+
+void GroupIcons::OnInitialized() {
+  // Forget the icons of deleted saved groups.
+  std::vector<std::string> deleted;
+  for (const auto [saved_id, entry] :
+       profile_->GetPrefs()->GetDict(kGroupIconsPref)) {
+    const base::Uuid guid = base::Uuid::ParseLowercase(saved_id);
+    if (!guid.is_valid() || !service_->GetGroup(guid)) {
+      deleted.push_back(saved_id);
+    }
+  }
+  if (!deleted.empty()) {
+    ScopedDictPrefUpdate update(profile_->GetPrefs(), kGroupIconsPref);
+    for (const std::string& saved_id : deleted) {
+      update->Remove(saved_id);
+    }
+  }
+  NotifyChanged();
+}
+
+void GroupIcons::OnTabGroupLocalIdChanged(
+    const base::Uuid& sync_id,
+    const std::optional<tab_groups::LocalTabGroupID>& local_id) {
+  NotifyChanged();
+}
+
+void GroupIcons::OnWillBeDestroyed() {
+  observation_.Reset();
+  service_ = nullptr;
+}
+
+void GroupIcons::FileSelected(const ui::SelectedFileInfo& file, int index) {
+  select_file_dialog_ = nullptr;
+  const std::optional<base::Uuid> saved_id = std::exchange(choosing_for_, {});
+  if (!saved_id) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadSvgFile, file.path()),
+      base::BindOnce(&GroupIcons::OnSvgFileRead, weak_factory_.GetWeakPtr(),
+                     *saved_id));
+}
+
+void GroupIcons::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  choosing_for_.reset();
+}
