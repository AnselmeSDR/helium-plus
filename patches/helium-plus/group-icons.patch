+GroupIconPicker::GroupIconPicker(GroupIcons& icons,
+                                 const tab_groups::TabGroupId& group)
+    : icons_(icons), group_(group) {
+  SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kVertical);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kRadioGroup);
+  GetViewAccessibility().SetName(GetString(StringId::kGroupIcon));
+
+  // Equal columns over the whole width, icons centered.
+  views::View* grid = AddChildView(std::make_unique<views::View>());
+  views::TableLayout* table =
+      grid->SetLayoutManager(std::make_unique<views::TableLayout>());
+  for (size_t i = 0; i < kIconsPerRow; ++i) {
+    table->AddColumn(views::LayoutAlignment::kCenter,
+                     views::LayoutAlignment::kCenter, /*horizontal_resize=*/1,
+                     views::TableLayout::ColumnSize::kUsePreferred, 0, 0);
+  }
+  const size_t icon_count = GroupIcons::GetLibrary().size() + 1;
+  table->AddRows((icon_count + kIconsPerRow - 1) / kIconsPerRow,
+                 views::TableLayout::kFixedSize);
+  AddIconButton(std::string(), vector_icons::kFolderFilledIcon,
+                GetString(StringId::kGroupIconFolder), *grid);
+  for (const GroupIcons::LibraryIcon& icon : GroupIcons::GetLibrary()) {
+    AddIconButton(std::string(icon.name), *icon.icon,
+                  GetString(icon.french_label, icon.english_label), *grid);
+  }
+
+  svg_button_ = AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&GroupIconPicker::ChooseSvgFile,
+                          base::Unretained(this)),
+      GetString(StringId::kGroupIconSvgFile)));
+  svg_button_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(kSvgButtonTopMargin, GetInternalPadding(), 0, 0));
+  svg_button_->SetProperty(views::kCrossAxisAlignmentKey,
+                           views::LayoutAlignment::kStart);
+
+  observation_.Observe(&icons);
+}
+
+GroupIconPicker::~GroupIconPicker() = default;
+
+void GroupIconPicker::AddIconButton(const std::string& name,
+                                    const gfx::VectorIcon& icon,
+                                    const std::u16string& label,
+                                    views::View& grid) {
+  std::unique_ptr<views::ImageButton> button =
+      views::CreateVectorImageButtonWithNativeTheme(
+          base::BindRepeating(
+              [](GroupIconPicker* picker, const std::string& name) {
+                picker->icons_->SetIconName(picker->group_, name);
+              },
+              base::Unretained(this), name),
+          icon, kIconSize);
+  button->SetBorder(views::CreateEmptyBorder(kIconPadding));
+  button->SetTooltipText(label);
+  button->GetViewAccessibility().SetRole(ax::mojom::Role::kRadioButton);
+  button->GetViewAccessibility().SetName(label);
+  buttons_.emplace_back(name, grid.AddChildView(std::move(button)));
+}
+
+void GroupIconPicker::ChooseSvgFile() {
+  views::Widget* widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  // The bubble closes: the dialog belongs to the browser window.
+  views::Widget* owner = widget->parent() ? widget->parent() : widget;
+  icons_->ChooseSvgFile(group_, owner->GetNativeWindow());
+  widget->Close();
+}
+
+void GroupIconPicker::UpdateSelection() {
+  const std::string selected_name = icons_->GetIconName(group_);
+  const bool svg = icons_->HasSvgIcon(group_);
+  for (auto& [name, button] : buttons_) {
+    const bool selected = !svg && name == selected_name;
+    button->SetBackground(
+        selected ? views::CreateRoundedRectBackground(
+                       ui::kColorSysTonalContainer, kSelectionCornerRadius)
+                 : nullptr);
+    button->GetViewAccessibility().SetCheckedState(
+        selected ? ax::mojom::CheckedState::kTrue
+                 : ax::mojom::CheckedState::kFalse);
+  }
+  // The chosen SVG icon is shown in its button.
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  svg_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      svg && color_provider
+          ? icons_->GetIcon(group_, color_provider->GetColor(ui::kColorIcon),
+                            kIconSize)
+          : ui::ImageModel());
+}
+
+void GroupIconPicker::OnGroupIconsChanged() {
+  UpdateSelection();
+}
+
+void GroupIconPicker::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateSelection();
+}
+
+BEGIN_METADATA(GroupIconPicker)
+END_METADATA
+
+std::unique_ptr<views::View> CreateGroupIconPicker(
+    Profile* profile,
+    const tab_groups::TabGroupId& group,
+    const gfx::Insets& margins) {
+  GroupIcons* icons = GroupIcons::Get(profile);
+  if (!icons) {
+    return std::make_unique<views::View>();
+  }
+  auto picker = std::make_unique<GroupIconPicker>(*icons, group);
+  picker->SetProperty(views::kMarginsKey, margins);
+  picker->SetProperty(views::kInternalPaddingKey,
+                      gfx::Insets::VH(0, GetInternalPadding()));
+  return picker;
+}
