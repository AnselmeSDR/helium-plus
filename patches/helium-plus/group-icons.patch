+// static
+void GroupIcons::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kGroupIconsPref);
+}
+
+// static
+GroupIcons* GroupIcons::Get(Profile* profile) {
+  tab_groups::TabGroupSyncService* service =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return nullptr;
+  }
+  auto* group_icons =
+      static_cast<GroupIcons*>(service->GetUserData(kGroupIconsKey));
+  if (!group_icons) {
+    auto owned = std::make_unique<GroupIcons>(profile, service);
+    group_icons = owned.get();
+    service->SetUserData(kGroupIconsKey, std::move(owned));
+  }
+  return group_icons;
+}
+
+GroupIcons::GroupIcons(Profile* profile,
+                       tab_groups::TabGroupSyncService* service)
+    : profile_(profile), service_(service) {
+  observation_.Observe(service);
+}
+
+GroupIcons::~GroupIcons() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+}
