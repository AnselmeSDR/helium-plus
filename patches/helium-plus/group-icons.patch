+// folder: one of a list of vector icons, or a monochrome SVG file (its paths
+// and basic shapes, drawn in the group color). Kept in the profile prefs by
+// saved group (TabGroupSyncService), as restored groups get new local ids.
+class GroupIcons : public base::SupportsUserData::Data,
+                   public tab_groups::TabGroupSyncService::Observer,
+                   public ui::SelectFileDialog::Listener {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnGroupIconsChanged() = 0;
+  };
+
+  struct LibraryIcon {
+    std::string_view name;
+    raw_ref<const gfx::VectorIcon> icon;
+    std::u16string_view french_label;
+    std::u16string_view english_label;
+  };
+
+  // The icons to choose from.
+  static base::span<const LibraryIcon> GetLibrary();
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // Null if the profile has no saved groups.
+  static GroupIcons* Get(Profile* profile);
+
+  GroupIcons(Profile* profile, tab_groups::TabGroupSyncService* service);
+  GroupIcons(const GroupIcons&) = delete;
+  GroupIcons& operator=(const GroupIcons&) = delete;
+  ~GroupIcons() override;
+
+  // Returns the icon of `group` in `color`, or an empty model if it has none.
+  ui::ImageModel GetIcon(const tab_groups::TabGroupId& group,
+                         SkColor color,
+                         int size) const;
+  // The name of the library icon of `group`, empty if it has none.
+  std::string GetIconName(const tab_groups::TabGroupId& group) const;
+  bool HasSvgIcon(const tab_groups::TabGroupId& group) const;
+
+  // An empty `name` removes the icon of `group`.
+  void SetIconName(const tab_groups::TabGroupId& group,
+                   const std::string& name);
+  // Asks for an SVG file, then uses it as the icon of `group`.
+  void ChooseSvgFile(const tab_groups::TabGroupId& group,
+                     gfx::NativeWindow owning_window);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  std::optional<base::Uuid> GetSavedId(
+      const tab_groups::TabGroupId& group) const;
+  const base::DictValue* GetEntry(const tab_groups::TabGroupId& group) const;
+  void SetEntry(const base::Uuid& saved_id,
+                std::optional<base::DictValue> entry);
+  void OnSvgFileRead(const base::Uuid& saved_id,
+                     std::optional<std::string> svg);
+  void OnSvgParsed(const base::Uuid& saved_id,
+                   base::expected<base::Value, std::string> result);
+  void NotifyChanged();
+
+  // tab_groups::TabGroupSyncService::Observer:
+  void OnInitialized() override;
+  void OnTabGroupLocalIdChanged(
+      const base::Uuid& sync_id,
+      const std::optional<tab_groups::LocalTabGroupID>& local_id) override;
+  void OnWillBeDestroyed() override;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+  const raw_ptr<Profile> profile_;
+  raw_ptr<tab_groups::TabGroupSyncService> service_;
+  base::ScopedObservation<tab_groups::TabGroupSyncService,
+                          tab_groups::TabGroupSyncService::Observer>
+      observation_{this};
+  base::ObserverList<Observer> observers_;
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  // The saved group an SVG file is being chosen for.
+  std::optional<base::Uuid> choosing_for_;
+  std::unique_ptr<data_decoder::DataDecoder> data_decoder_;
+  base::WeakPtrFactory<GroupIcons> weak_factory_{this};
+};
