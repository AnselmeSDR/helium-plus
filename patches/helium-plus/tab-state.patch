+// Copyright 2026 The Helium+ Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_plus/tab_state.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/supports_user_data.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/invalidate_type.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/page_transition_types.h"
+
+namespace helium_plus {
+
+namespace {
+
+const char kRestoredDataKey[] = "helium_plus_restored_data";
+
+// Restored extra data waiting for the tab to be created.
+struct RestoredData : public base::SupportsUserData::Data {
+  std::map<std::string, std::string> extra_data;
+};
+
+GURL GetCurrentUrl(content::WebContents* contents) {
+  const GURL& url = contents->GetLastCommittedURL();
+  return url.is_valid() ? url : contents->GetVisibleURL();
+}
+
+}  // namespace
+
+DEFINE_USER_DATA(TabState);
+
+TabState::TabState(tabs::TabInterface& tab)
+    : ContentsObservingTabFeature(tab),
+      scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {
+  if (content::WebContents* contents = tab.GetContents()) {
+    if (auto* restored = static_cast<RestoredData*>(
+            contents->GetUserData(kRestoredDataKey))) {
+      RestoreFrom(restored->extra_data);
+      contents->RemoveUserData(kRestoredDataKey);
+    }
+  }
+
+  pinned_subscription_ = tab.RegisterPinnedStateChanged(base::BindRepeating(
+      [](TabState* state, tabs::TabInterface*, bool) {
+        state->OnAnchoringChanged();
+      },
+      base::Unretained(this)));
+  group_subscription_ = tab.RegisterGroupChanged(base::BindRepeating(
+      [](TabState* state, tabs::TabInterface*,
+         std::optional<tab_groups::TabGroupId>) {
+        state->OnAnchoringChanged();
+      },
+      base::Unretained(this)));
+}
+
+TabState::~TabState() = default;
+
+// static
+TabState* TabState::From(tabs::TabInterface* tab) {
+  return Get(tab->GetUnownedUserDataHost());
+}
+
+// static
+const TabState* TabState::From(const tabs::TabInterface* tab) {
+  return Get(tab->GetUnownedUserDataHost());
+}
+
+// static
+TabState* TabState::FromWebContents(content::WebContents* contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? From(tab) : nullptr;
+}
+
+// static
+void TabState::StashRestoredData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  auto data = std::make_unique<RestoredData>();
+  for (const char* key : {kCustomTitleKey, kAnchorUrlKey, kAnchorTitleKey}) {
+    auto it = extra_data.find(key);
+    if (it != extra_data.end() && !it->second.empty()) {
+      data->extra_data.insert(*it);
+    }
+  }
+  if (data->extra_data.empty()) {
+    return;
+  }
+  contents->SetUserData(kRestoredDataKey, std::move(data));
+}
+
+// static
+void TabState::PopulateExtraData(
+    const tabs::TabInterface* tab,
+    std::map<std::string, std::string>* extra_data) {
+  const TabState* state = tab ? From(tab) : nullptr;
+  if (!state) {
+    return;
+  }
+  if (!state->custom_title_.empty()) {
+    (*extra_data)[kCustomTitleKey] = base::UTF16ToUTF8(state->custom_title_);
+  }
+  if (state->anchor_url_.is_valid()) {
+    (*extra_data)[kAnchorUrlKey] = state->anchor_url_.spec();
+    if (!state->anchor_title_.empty()) {
+      (*extra_data)[kAnchorTitleKey] = base::UTF16ToUTF8(state->anchor_title_);
+    }
+  }
+}
+
+void TabState::SetCustomTitle(std::u16string title) {
+  if (title == custom_title_) {
+    return;
+  }
+  custom_title_ = std::move(title);
+  Persist(kCustomTitleKey, base::UTF16ToUTF8(custom_title_));
+  NotifyTitleChanged();
+}
+
+bool TabState::IsAnchored() const {
+  return tab().IsPinned() || tab().GetGroup().has_value();
+}
+
+void TabState::SetAnchorToCurrentPage() {
+  content::WebContents* contents = tab().GetContents();
+  if (!contents) {
+    return;
+  }
+  const GURL url = GetCurrentUrl(contents);
+  if (!url.is_valid() || url.IsAboutBlank()) {
+    return;
+  }
+  SetAnchor(url, contents->GetTitle());
+}
+
+void TabState::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      !IsAnchored()) {
+    return;
+  }
+  // A tab anchored before its first page committed gets anchored here.
+  if (!anchor_url_.is_valid()) {
+    SetAnchorToCurrentPage();
+    return;
+  }
+  UpdateDiverged(handle);
+}
+
+void TabState::TitleWasSet(content::NavigationEntry* entry) {
+  if (!entry || !anchor_url_.is_valid() || !anchor_title_.empty() ||
+      entry->GetURL() != anchor_url_) {
+    return;
+  }
+  SetAnchor(anchor_url_, entry->GetTitle());
+}
+
+void TabState::OnAnchoringChanged() {
+  if (!IsAnchored()) {
+    SetAnchor(GURL(), std::u16string());
+    return;
+  }
+  if (!anchor_url_.is_valid()) {
+    SetAnchorToCurrentPage();
+  }
+}
+
+void TabState::SetAnchor(GURL url, std::u16string title) {
+  if (url == anchor_url_ && title == anchor_title_) {
+    return;
+  }
+  if (url != anchor_url_) {
+    SetDiverged(false);
+  }
+  anchor_url_ = std::move(url);
+  anchor_title_ = std::move(title);
+  Persist(kAnchorUrlKey,
+          anchor_url_.is_valid() ? anchor_url_.spec() : std::string());
+  Persist(kAnchorTitleKey, base::UTF16ToUTF8(anchor_title_));
+}
+
+void TabState::UpdateDiverged(content::NavigationHandle* handle) {
+  // The anchor and its redirects are on the anchor. Pages of a web app
+  // (same-document navigations), client redirects and reloads keep the state.
+  const GURL anchor = anchor_url_.GetWithoutRef();
+  if (handle->GetURL().GetWithoutRef() == anchor ||
+      (!handle->GetRedirectChain().empty() &&
+       handle->GetRedirectChain().front().GetWithoutRef() == anchor)) {
+    SetDiverged(false);
+    return;
+  }
+  const ui::PageTransition transition = handle->GetPageTransition();
+  if (handle->IsSameDocument() ||
+      handle->GetReloadType() != content::ReloadType::NONE ||
+      ui::PageTransitionCoreTypeIs(transition, ui::PAGE_TRANSITION_RELOAD) ||
+      (transition & ui::PAGE_TRANSITION_CLIENT_REDIRECT)) {
+    return;
+  }
+  SetDiverged(true);
+}
+
+void TabState::SetDiverged(bool diverged) {
+  if (diverged_ == diverged) {
+    return;
+  }
+  diverged_ = diverged;
+  if (content::WebContents* contents = tab().GetContents()) {
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+  }
+}
+
+void TabState::RestoreFrom(
+    const std::map<std::string, std::string>& extra_data) {
+  if (auto it = extra_data.find(kCustomTitleKey); it != extra_data.end()) {
+    custom_title_ = base::UTF8ToUTF16(it->second);
+  }
+  if (auto it = extra_data.find(kAnchorUrlKey); it != extra_data.end()) {
+    anchor_url_ = GURL(it->second);
+  }
+  if (auto it = extra_data.find(kAnchorTitleKey); it != extra_data.end()) {
+    anchor_title_ = base::UTF8ToUTF16(it->second);
+  }
+}
+
+void TabState::Persist(const char* key, const std::string& value) {
+  content::WebContents* contents = tab().GetContents();
+  if (!contents) {
+    return;
+  }
+  SessionService* service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!service || !window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  service->AddTabExtraData(window_id, tab_id, key, value);
+}
+
+void TabState::NotifyTitleChanged() {
+  if (content::WebContents* contents = tab().GetContents()) {
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TITLE);
+  }
+}
+
+}  // namespace helium_plus
