+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_PLUS_TAB_STATE_H_
+#define CHROME_BROWSER_UI_HELIUM_PLUS_TAB_STATE_H_
+
+#include <map>
+#include <string>
+
+#include "base/callback_list.h"
+#include "chrome/browser/ui/tabs/contents_observing_tab_feature.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "url/gurl.h"
+
+namespace content {
+class NavigationEntry;
+class NavigationHandle;
+class WebContents;
+}  // namespace content
+
+namespace helium_plus {
+
+// Session extra data keys.
+inline constexpr char kCustomTitleKey[] = "helium_plus.custom_title";
+inline constexpr char kAnchorUrlKey[] = "helium_plus.anchor_url";
+inline constexpr char kAnchorTitleKey[] = "helium_plus.anchor_title";
+
+// Per-tab Helium+ state, owned by TabFeatures: a custom title and, for anchored
+// tabs (pinned or grouped), the URL the tab comes back to. Saved with the
+// session as tab extra data.
+class TabState : public tabs::ContentsObservingTabFeature {
+ public:
+  DECLARE_USER_DATA(TabState);
+
+  explicit TabState(tabs::TabInterface& tab);
+  TabState(const TabState&) = delete;
+  TabState& operator=(const TabState&) = delete;
+  ~TabState() override;
+
+  static TabState* From(tabs::TabInterface* tab);
+  static const TabState* From(const tabs::TabInterface* tab);
+  static TabState* FromWebContents(content::WebContents* contents);
+
+  // Keeps restored extra data on `contents` until its tab is created.
+  static void StashRestoredData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  // Adds the state of the tab to session `extra_data`.
+  static void PopulateExtraData(
+      const tabs::TabInterface* tab,
+      std::map<std::string, std::string>* extra_data);
+
+  const std::u16string& custom_title() const { return custom_title_; }
+  // An empty title goes back to the page title.
+  void SetCustomTitle(std::u16string title);
+
+  bool IsAnchored() const;
+  const GURL& anchor_url() const { return anchor_url_; }
+  const std::u16string& anchor_title() const { return anchor_title_; }
+  void SetAnchorToCurrentPage();
+  // True when the user left the anchor page for another one: closing the tab
+  // first brings it back to its anchor.
+  bool IsDiverged() const { return diverged_; }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void TitleWasSet(content::NavigationEntry* entry) override;
+
+ private:
+  void OnAnchoringChanged();
+  void SetAnchor(GURL url, std::u16string title);
+  void UpdateDiverged(content::NavigationHandle* handle);
+  void SetDiverged(bool diverged);
+  void RestoreFrom(const std::map<std::string, std::string>& extra_data);
+  void Persist(const char* key, const std::string& value);
+  void NotifyTitleChanged();
+
+  std::u16string custom_title_;
+  GURL anchor_url_;
+  std::u16string anchor_title_;
+  bool diverged_ = false;
+  base::CallbackListSubscription pinned_subscription_;
+  base::CallbackListSubscription group_subscription_;
+  ui::ScopedUnownedUserData<TabState> scoped_unowned_user_data_;
+};
+
+}  // namespace helium_plus
+
+#endif  // CHROME_BROWSER_UI_HELIUM_PLUS_TAB_STATE_H_
