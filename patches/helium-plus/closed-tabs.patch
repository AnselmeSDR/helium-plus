+class ClosedTabView : public views::Button {
+  METADATA_HEADER(ClosedTabView, views::Button)
+
+ public:
+  explicit ClosedTabView(bool pinned);
+  ClosedTabView(const ClosedTabView&) = delete;
+  ClosedTabView& operator=(const ClosedTabView&) = delete;
+  ~ClosedTabView() override;
+
+  // `keeper` is the tab keeping `closed_tab`.
+  void SetClosedTab(const ClosedTab& closed_tab,
+                    const tabs::TabInterface& keeper);
+
+  int closed_tab_id() const { return closed_tab_id_; }
+  tabs::TabHandle keeper() const { return keeper_; }
+  const ui::ImageModel& favicon() const { return favicon_; }
+  const std::u16string& title() const { return title_text_; }
+
+  // Opens the closed tab.
+  void Open();
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  void StateChanged(ButtonState old_state) override;
+
+ private:
+  void LoadFavicon(Profile* profile);
+  void OnFaviconLoaded(const favicon_base::FaviconImageResult& result);
+  void UpdateColors();
+
+  const bool pinned_;
+  int closed_tab_id_ = 0;
+  GURL url_;
+  std::u16string title_text_;
+  tabs::TabHandle keeper_;
+  ui::ImageModel favicon_;
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<TabTitle> title_ = nullptr;
+  base::CancelableTaskTracker favicon_tracker_;
+  base::WeakPtrFactory<ClosedTabView> weak_factory_{this};
+};
+
+// The closed tabs of a container of the vertical tab strip (a tab group or the
+// pinned tabs), shown among its tabs.
+class ClosedTabViews {
+ public:
+  using GetChildrenCallback =
+      base::RepeatingCallback<TabCollectionNode::ChildViews()>;
+
+  // `get_children` returns the children of the container (tabs and split
+  // tabs); `on_updated` runs once closed tab views were added or removed.
+  ClosedTabViews(views::View& host,
+                 bool pinned,
+                 GetChildrenCallback get_children,
+                 base::RepeatingClosure on_updated);
+  ClosedTabViews(const ClosedTabViews&) = delete;
+  ClosedTabViews& operator=(const ClosedTabViews&) = delete;
+  ~ClosedTabViews();
+
+  // Updates the closed tab views soon, once the closed tabs changed.
+  void ScheduleUpdate();
+
+  // Returns `children` with the views of their closed tabs around them, in
+  // display order.
+  std::vector<views::View*> GetChildren(
+      TabCollectionNode::ChildViews children) const;
+
+  // Hides the closed tab views missing from `children`, whose closed tab moved
+  // and that the next update removes.
+  void HideMissingViews(const std::vector<views::View*>& children,
+                        views::ProposedLayout& layouts) const;
+
+ private:
+  void Update();
+
+  const raw_ref<views::View> host_;
+  const bool pinned_;
+  const GetChildrenCallback get_children_;
+  const base::RepeatingClosure on_updated_;
+  std::map<int, raw_ptr<ClosedTabView>> views_;
+  bool update_pending_ = false;
+  base::WeakPtrFactory<ClosedTabViews> weak_factory_{this};
+};
