+// Like Arc, a closed anchored tab (pinned or grouped) stays in its container
+// without using memory: once inactive, it becomes a ClosedTab kept by a
+// neighbor tab of the container (see TabState::closed_before()) and its
+// WebContents is deleted. The vertical tab strip shows closed tabs in their
+// place; clicking one opens it again there. A container whose tabs are all
+// closed keeps one of them as a real tab, as Chromium deletes empty groups.
+class ClosedTabsService : public BrowserCollectionObserver,
+                          public TabStripModelObserver {
+ public:
+  static void EnsureStarted();
+
+  // Opens the closed tab `id` of `model` in its place and activates it.
+  static void Open(TabStripModel& model, int id);
+
+  ClosedTabsService(const ClosedTabsService&) = delete;
+  ClosedTabsService& operator=(const ClosedTabsService&) = delete;
+
+ private:
+  friend class base::NoDestructor<ClosedTabsService>;
+
+  // The pinned tabs or a group.
+  struct Container {
+    bool pinned = false;
+    std::optional<tab_groups::TabGroupId> group;
+
+    bool IsValid() const { return pinned || group.has_value(); }
+    bool operator==(const Container&) const = default;
+  };
+
+  // A tab as of the last update.
+  struct Slot {
+    Slot();
+    Slot(Slot&&);
+    Slot& operator=(Slot&&);
+    ~Slot();
+
+    tabs::TabHandle tab;
+    Container container;
+    // Once the tab left the tab strip, its closed tabs are held here.
+    bool removed = false;
+    bool deleted = false;
+    ClosedTabs held_before;
+    ClosedTabs held_after;
+  };
+
+  struct ModelState {
+    ModelState();
+    ~ModelState();
+
+    std::vector<Slot> slots;
+    std::map<tab_groups::TabGroupId, tab_groups::TabGroupVisualData>
+        group_visuals;
+    // Tabs moved since the last update.
+    std::set<tabs::TabHandle> moved;
+    bool update_pending = false;
+  };
+
+  // Closed tabs left without a container, to keep in a new carrier tab.
+  struct Orphans {
+    Orphans();
+    Orphans(Orphans&&);
+    ~Orphans();
+
+    Container container;
+    int index = 0;
+    ClosedTabs closed_tabs;
+  };
+
+  static ClosedTabsService* Get();
+
+  ClosedTabsService();
+  ~ClosedTabsService() override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void TabGroupedStateChanged(TabStripModel* model,
+                              std::optional<tab_groups::TabGroupId> old_group,
+                              std::optional<tab_groups::TabGroupId> new_group,
+                              tabs::TabInterface* tab,
+                              int index) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+
+  void Observe(TabStripModel* model);
+  void HoldClosedTabs(ModelState& state, tabs::TabInterface* tab, bool deleted);
+  void ScheduleUpdate(TabStripModel* model);
+  void Update(TabStripModel* model);
+  // Runs a pending update, without compacting. Returns false when the tab
+  // strip cannot be changed for now.
+  bool Flush(TabStripModel& model);
+  // Gives the closed tabs of the tabs that left their container to their
+  // former neighbors.
+  void Reconcile(TabStripModel& model, ModelState& state);
+  void KeepOrphans(TabStripModel& model,
+                   const ModelState& state,
+                   Orphans orphans);
+  // Whether the saved tab groups are connected to the groups of `model`: once
+  // initialized, the TabGroupSyncService matches a restored group with its
+  // saved tabs and reopens the ones missing from it. Updates `model` then.
+  bool AreSavedGroupsConnected(TabStripModel& model);
+  // Turns the closed inactive tabs into ClosedTabs, those of a group once the
+  // saved tab groups are connected.
+  void Compact(TabStripModel& model);
+  void TakeSnapshot(TabStripModel& model, ModelState& state);
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+  std::map<raw_ptr<TabStripModel>, ModelState> states_;
+};
