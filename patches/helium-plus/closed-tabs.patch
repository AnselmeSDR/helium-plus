+
+void ClosedTabsService::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  auto it = states_.find(model);
+  if (it == states_.end() || model->closing_all()) {
+    return;
+  }
+  if (change.type() == TabStripModelChange::kRemoved) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      HoldClosedTabs(it->second, removed.tab,
+                     removed.remove_reason == TabRemovedReason::kDeleted);
+    }
+  } else if (change.type() == TabStripModelChange::kMoved) {
+    it->second.moved.insert(change.GetMove()->tab->GetHandle());
+  }
+  ScheduleUpdate(model);
+}
+
+void ClosedTabsService::OnTabChangedAt(tabs::TabInterface* tab,
+                                       TabChangeType change_type) {
+  // A tab just closed by the user.
+  const TabState* state = TabState::From(tab);
+  if (state && state->IsClosed() && !tab->IsActivated()) {
+    ScheduleUpdate(tab->GetBrowserWindowInterface()->GetTabStripModel());
+  }
+}
+
+void ClosedTabsService::OnTabPinnedStateChanged(tabs::TabInterface* tab,
