+constexpr int kIconSize = 16;
+// Matches TabViewVerticalLayout.
+constexpr int kIconTitleSpacing = 7;
+constexpr int kTitleTrailingPadding = 4;
+
+// Returns the tabs of a container child: a tab or a split tab.
+std::vector<const tabs::TabInterface*> GetTabs(const views::View& child) {
+  std::vector<const tabs::TabInterface*> tabs;
+  auto add_tab = [&tabs](const views::View& view) {
+    const TabView* tab_view = views::AsViewClass<TabView>(&view);
+    if (const tabs::TabInterface* tab =
+            tab_view ? tab_view->GetTabInterface() : nullptr) {
+      tabs.push_back(tab);
+    }
+  };
+  if (views::IsViewClass<SplitTabView>(&child)) {
+    for (const views::View* split_child : child.children()) {
+      add_tab(*split_child);
+    }
+  } else {
+    add_tab(child);
+  }
+  return tabs;
+}
+
+}  // namespace
