+// static
+void ClosedTabsService::Open(TabStripModel& model, int id) {
+  ClosedTabsService* service = Get();
+  auto state_it = service->states_.find(&model);
+  if (state_it == service->states_.end() || !service->Flush(model)) {
+    return;
+  }
+
+  for (int index = 0; index < model.count(); ++index) {
+    tabs::TabInterface* keeper = model.GetTabAtIndex(index);
+    TabState* keeper_state = TabState::From(keeper);
+    if (!keeper_state) {
+      continue;
+    }
+    ClosedTabs before = keeper_state->closed_before();
+    ClosedTabs after = keeper_state->closed_after();
+    auto before_it = std::ranges::find(before, id, &ClosedTab::id);
+    auto after_it = std::ranges::find(after, id, &ClosedTab::id);
+    if (before_it == before.end() && after_it == after.end()) {
+      continue;
+    }
+    // Connecting a group to its saved tabs would close the tab added to it.
+    if (keeper->GetGroup() && !service->AreSavedGroupsConnected(model)) {
+      return;
+    }
+
+    // The new tab takes the closed tabs between it and the keeper.
+    ClosedTabs new_before;
+    ClosedTabs new_after;
+    std::optional<ClosedTab> closed_tab;
+    int insert_index;
+    if (before_it != before.end()) {
+      closed_tab = *before_it;
+      new_before.assign(before.begin(), before_it);
+      new_after.assign(before_it + 1, before.end());
+      before.clear();
+      insert_index = SkipSplit(model, index, /*forward=*/false);
+    } else {
+      closed_tab = *after_it;
+      new_after.assign(after_it + 1, after.end());
+      after.erase(after_it, after.end());
+      insert_index = SkipSplit(model, index + 1, /*forward=*/true);
+    }
+    TabState* new_state = AddTab(model, *closed_tab, insert_index,
+                                 keeper->GetGroup(), keeper->IsPinned(),
+                                 /*select=*/true);
+    if (!new_state) {
+      return;
+    }
+    keeper_state->SetClosedTabs(std::move(before), std::move(after));
+    new_state->SetClosedTabs(std::move(new_before), std::move(new_after));
+    service->TakeSnapshot(model, state_it->second);
+    return;
+  }
+}
