+ClosedTabView::ClosedTabView(bool pinned)
+    : views::Button(
+          base::BindRepeating(&ClosedTabView::Open, base::Unretained(this))),
+      pinned_(pinned) {
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetImageSize(gfx::Size(kIconSize, kIconSize));
+  icon_->SetCanProcessEventsWithinSubtree(false);
+  title_ = AddChildView(std::make_unique<TabTitle>());
+  title_->SetVisible(!pinned_);
+  SetFocusBehavior(FocusBehavior::NEVER);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+}
+
+ClosedTabView::~ClosedTabView() = default;
+
+void ClosedTabView::SetClosedTab(const ClosedTab& closed_tab,
+                                 const tabs::TabInterface& keeper) {
+  closed_tab_id_ = closed_tab.id;
+  keeper_ = keeper.GetHandle();
+
+  std::u16string title = closed_tab.custom_title;
+  if (title.empty()) {
+    title = closed_tab.title;
+  }
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(closed_tab.url.spec());
+  }
+  if (title != title_text_) {
+    title_text_ = std::move(title);
+    title_->SetText(title_text_);
+    SetTooltipText(title_text_);
+    GetViewAccessibility().SetName(title_text_);
+  }
+
+  if (closed_tab.url != url_ || favicon_.IsEmpty()) {
+    url_ = closed_tab.url;
+    content::WebContents* contents = keeper.GetContents();
+    LoadFavicon(contents
+                    ? Profile::FromBrowserContext(contents->GetBrowserContext())
+                    : nullptr);
+  }
+}
+
+void ClosedTabView::Open() {
+  tabs::TabInterface* keeper = keeper_.Get();
+  BrowserWindowInterface* browser =
+      keeper ? keeper->GetBrowserWindowInterface() : nullptr;
+  if (!browser) {
+    return;
+  }
+  ClosedTabsService::Open(*browser->GetTabStripModel(), closed_tab_id_);
+}
+
+gfx::Size ClosedTabView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(
+      GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+      GetLayoutConstant(pinned_ ? LayoutConstant::kVerticalTabPinnedHeight
+                                : LayoutConstant::kVerticalTabHeight));
+}
+
+void ClosedTabView::Layout(PassKey) {
+  // A pinned tile, or a collapsed tab strip, only shows the icon.
+  const bool centered =
+      pinned_ ||
+      width() < 2 * GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  title_->SetVisible(!centered);
+  if (centered) {
+    icon_->SetBounds((width() - kIconSize) / 2, (height() - kIconSize) / 2,
+                     kIconSize, kIconSize);
+    return;
+  }
+  gfx::Rect bounds = GetLocalBounds();
+  bounds.Inset(gfx::Insets::VH(
+      GetLayoutConstant(LayoutConstant::kTabVerticalPadding),
+      GetLayoutConstant(LayoutConstant::kTabHorizontalPadding)));
+  icon_->SetBounds(bounds.x(), bounds.y() + (bounds.height() - kIconSize) / 2,
+                   kIconSize, kIconSize);
+  const int title_x = bounds.x() + kIconSize + kIconTitleSpacing;
+  const int line_height = title_->GetLineHeight();
+  title_->SetBounds(
+      title_x, bounds.y() + (bounds.height() - line_height) / 2,
+      std::max(0, bounds.right() - kTitleTrailingPadding - title_x),
+      line_height);
+}
+
+void ClosedTabView::OnPaintBackground(gfx::Canvas* canvas) {
+  if (GetState() != STATE_HOVERED && GetState() != STATE_PRESSED) {
+    return;
+  }
+  const bool frame_active =
+      GetWidget() ? GetWidget()->ShouldPaintAsActive() : true;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(TabStyle::Get()->GetTabBackgroundColor(
+      TabStyle::TabSelectionState::kInactive, /*hovered=*/true, frame_active,
+      GetColorProvider()));
+  canvas->DrawRoundRect(
+      GetLocalBounds(),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), flags);
+}
+
+void ClosedTabView::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  UpdateColors();
+}
+
+void ClosedTabView::StateChanged(ButtonState old_state) {
+  views::Button::StateChanged(old_state);
+  SchedulePaint();
+}
+
+void ClosedTabView::LoadFavicon(Profile* profile) {
+  favicon_tracker_.TryCancelAll();
+  favicon_ = favicon::GetDefaultFaviconModel();
+  icon_->SetImage(favicon_);
+  favicon::FaviconService* service =
+      profile ? FaviconServiceFactory::GetForProfile(
+                    profile, ServiceAccessType::EXPLICIT_ACCESS)
+              : nullptr;
+  if (!service) {
+    return;
+  }
+  service->GetFaviconImageForPageURL(
+      url_,
+      base::BindOnce(&ClosedTabView::OnFaviconLoaded,
+                     weak_factory_.GetWeakPtr()),
+      &favicon_tracker_);
+}
+
+void ClosedTabView::OnFaviconLoaded(
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  favicon_ = ui::ImageModel::FromImage(result.image);
+  icon_->SetImage(favicon_);
+}
+
+void ClosedTabView::UpdateColors() {
+  const ui::ColorProvider* color_provider = GetColorProvider();
+  if (!color_provider) {
+    return;
+  }
+  const bool frame_active =
+      GetWidget() ? GetWidget()->ShouldPaintAsActive() : true;
+  title_->SetEnabledColor(TabStyle::Get()->GetTabForegroundColor(
+      /*apparently_active=*/false, frame_active, color_provider));
+  if (pinned_) {
+    SetBorder(views::CreateRoundedRectBorder(
+        GetLayoutConstant(LayoutConstant::kVerticalTabPinnedBorderThickness),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius),
+        frame_active ? kColorVerticalTabPinnedOutline
+                     : kColorTabDividerFrameInactive));
+  }
+}
