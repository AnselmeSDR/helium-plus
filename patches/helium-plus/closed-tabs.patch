+void ClosedTabViews::ScheduleUpdate() {
+  if (update_pending_) {
+    return;
+  }
+  update_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ClosedTabViews::Update, weak_factory_.GetWeakPtr()));
+}
+
+std::vector<views::View*> ClosedTabViews::GetChildren(
+    TabCollectionNode::ChildViews children) const {
+  std::vector<views::View*> result;
+  auto append = [this, &result](const ClosedTabs& closed_tabs) {
+    for (const ClosedTab& closed_tab : closed_tabs) {
+      if (auto it = views_.find(closed_tab.id); it != views_.end()) {
+        result.push_back(it->second.get());
+      }
+    }
+  };
+  for (views::View* child : children) {
+    const std::vector<const tabs::TabInterface*> tabs = GetTabs(*child);
+    for (const tabs::TabInterface* tab : tabs) {
+      if (const TabState* state = TabState::From(tab)) {
+        append(state->closed_before());
+      }
+    }
+    result.push_back(child);
+    for (const tabs::TabInterface* tab : tabs) {
+      if (const TabState* state = TabState::From(tab)) {
+        append(state->closed_after());
+      }
+    }
+  }
+  return result;
+}
+
+void ClosedTabViews::HideMissingViews(const std::vector<views::View*>& children,
+                                      views::ProposedLayout& layouts) const {
+  for (const auto& [id, view] : views_) {
+    if (!std::ranges::contains(children, view.get())) {
+      layouts.child_layouts.emplace_back(view.get(), false, gfx::Rect());
+    }
+  }
+}
+
+void ClosedTabViews::Update() {
+  update_pending_ = false;
+  std::set<int> ids;
+  bool changed = false;
+  for (views::View* child : get_children_.Run()) {
+    for (const tabs::TabInterface* tab : GetTabs(*child)) {
+      const TabState* state = TabState::From(tab);
+      if (!state) {
+        continue;
+      }
+      for (const ClosedTabs* closed_tabs :
+           {&state->closed_before(), &state->closed_after()}) {
+        for (const ClosedTab& closed_tab : *closed_tabs) {
+          ids.insert(closed_tab.id);
+          if (auto it = views_.find(closed_tab.id); it != views_.end()) {
+            it->second->SetClosedTab(closed_tab, *tab);
+            continue;
+          }
+          // Adding the view lays out the host: it is listed once added.
+          auto view = std::make_unique<ClosedTabView>(pinned_);
+          view->SetClosedTab(closed_tab, *tab);
+          views_[closed_tab.id] = host_->AddChildView(std::move(view));
+          changed = true;
+        }
+      }
+    }
+  }
+  for (auto it = views_.begin(); it != views_.end();) {
+    if (ids.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    ClosedTabView* view = it->second;
+    it = views_.erase(it);
+    host_->RemoveChildViewT(view);
+    changed = true;
+  }
+  host_->InvalidateLayout();
+  if (changed) {
+    on_updated_.Run();
+  }
+}
