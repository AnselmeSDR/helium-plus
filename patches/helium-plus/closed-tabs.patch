+
+// Session extra data values are limited to 64 KB: closed tabs are saved in
+// chunks of about this size, under their key, then `key`.1, `key`.2...
+constexpr size_t kClosedTabsChunkSize = 32 * 1024;
+
+std::string GetChunkKey(const char* key, size_t index) {
+  return index == 0 ? std::string(key)
+                    : base::StrCat({key, ".", base::NumberToString(index)});
+}
+
+bool IsChunkKey(const std::string& key, const char* base_key) {
+  return key.starts_with(base::StrCat({base_key, "."}));
+}
+
+std::vector<std::string> SerializeClosedTabs(const ClosedTabs& closed_tabs) {
+  std::vector<std::string> chunks;
+  base::ListValue list;
+  size_t size = 0;
+  auto flush = [&] {
+    if (!list.empty()) {
+      chunks.push_back(base::WriteJson(list).value_or(std::string()));
+      list = base::ListValue();
+      size = 0;
+    }
+  };
+  for (const ClosedTab& closed_tab : closed_tabs) {
+    // At most 3 UTF-8 bytes per title character, plus the JSON syntax.
+    const size_t entry_size =
+        closed_tab.url.spec().size() +
+        3 * (closed_tab.title.size() + closed_tab.custom_title.size()) + 32;
+    if (size + entry_size > kClosedTabsChunkSize) {
+      flush();
+    }
+    base::DictValue dict;
+    dict.Set("url", closed_tab.url.spec());
+    if (!closed_tab.title.empty()) {
+      dict.Set("title", closed_tab.title);
+    }
+    if (!closed_tab.custom_title.empty()) {
+      dict.Set("name", closed_tab.custom_title);
+    }
+    list.Append(std::move(dict));
+    size += entry_size;
+  }
+  flush();
+  return chunks;
+}
+
+void ParseClosedTabs(const std::string& json, ClosedTabs& closed_tabs) {
+  std::optional<base::ListValue> list =
+      base::JSONReader::ReadList(json, base::JSON_PARSE_RFC);
+  if (!list) {
+    return;
+  }
+  for (const base::Value& item : *list) {
+    const base::DictValue* dict = item.GetIfDict();
+    const std::string* url = dict ? dict->FindString("url") : nullptr;
+    if (!url || !GURL(*url).is_valid()) {
+      continue;
+    }
+    const std::string* title = dict->FindString("title");
+    const std::string* name = dict->FindString("name");
+    closed_tabs.emplace_back(
+        GURL(*url), title ? base::UTF8ToUTF16(*title) : std::u16string(),
+        name ? base::UTF8ToUTF16(*name) : std::u16string());
+  }
+}
+
+// Reads the chunks of closed tabs saved under `key`.
+ClosedTabs RestoreClosedTabs(
+    const std::map<std::string, std::string>& extra_data,
+    const char* key,
+    size_t& saved_chunks) {
+  ClosedTabs closed_tabs;
+  for (size_t index = 0;; ++index) {
+    auto it = extra_data.find(GetChunkKey(key, index));
+    if (it == extra_data.end()) {
+      break;
+    }
+    ParseClosedTabs(it->second, closed_tabs);
+    saved_chunks = index + 1;
+  }
+  return closed_tabs;
+}
+
+void AddClosedTabs(const char* key,
+                   const ClosedTabs& closed_tabs,
+                   std::map<std::string, std::string>* extra_data) {
+  const std::vector<std::string> chunks = SerializeClosedTabs(closed_tabs);
+  for (size_t index = 0; index < chunks.size(); ++index) {
+    (*extra_data)[GetChunkKey(key, index)] = chunks[index];
+  }
+}
