+
+void ClosedTabsService::Observe(TabStripModel* model) {
+  if (states_.contains(model)) {
+    return;
+  }
+  model->AddObserver(this);
+  ScheduleUpdate(model);
+}
+
+void ClosedTabsService::HoldClosedTabs(ModelState& state,
+                                       tabs::TabInterface* tab,
+                                       bool deleted) {
+  auto slot = std::ranges::find(state.slots, tab->GetHandle(), &Slot::tab);
+  if (slot == state.slots.end()) {
+    return;
+  }
+  slot->removed = true;
+  slot->deleted = deleted;
+  TabState* tab_state = TabState::From(tab);
+  if (!tab_state || !HasClosedTabs(*tab_state)) {
+    return;
+  }
+  slot->held_before = tab_state->closed_before();
+  slot->held_after = tab_state->closed_after();
+  // A tab moving to another window leaves its closed tabs here.
+  if (!deleted) {
+    tab_state->SetClosedTabs(ClosedTabs(), ClosedTabs());
+  }
+}
+
+void ClosedTabsService::ScheduleUpdate(TabStripModel* model) {
+  ModelState& state = states_[model];
+  if (state.update_pending) {
+    return;
+  }
+  state.update_pending = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ClosedTabsService::Update,
+                                base::Unretained(this), model));
+}
+
+void ClosedTabsService::Update(TabStripModel* model) {
+  auto it = states_.find(model);
+  if (it == states_.end() || !it->second.update_pending) {
+    return;
+  }
+  if (model->closing_all()) {
+    it->second.update_pending = false;
+    return;
+  }
+  if (!model->delegate()->IsTabStripEditable()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&ClosedTabsService::Update, base::Unretained(this),
+                       model),
+        kRetryDelay);
+    return;
+  }
+  it->second.update_pending = false;
+  Reconcile(*model, it->second);
+  Compact(*model);
+  TakeSnapshot(*model, it->second);
+}
+
+bool ClosedTabsService::Flush(TabStripModel& model) {
+  ModelState& state = states_[&model];
+  if (model.closing_all() || !model.delegate()->IsTabStripEditable()) {
+    return false;
+  }
+  if (state.update_pending) {
+    state.update_pending = false;
+    Reconcile(model, state);
+    TakeSnapshot(model, state);
+  }
+  return true;
+}
+
+void ClosedTabsService::Reconcile(TabStripModel& model, ModelState& state) {
+  // The tab of `slot` if it is still in `container`.
+  auto tab_in = [&model](const Slot& slot,
+                         const Container& container) -> tabs::TabInterface* {
+    tabs::TabInterface* tab = slot.removed ? nullptr : slot.tab.Get();
+    if (!tab || model.GetIndexOfTab(tab) == TabStripModel::kNoTab ||
+        Container{tab->IsPinned(), tab->GetGroup()} != container) {
+      return nullptr;
+    }
+    return tab;
+  };
+
+  std::vector<Orphans> all_orphans;
+  for (size_t begin = 0; begin < state.slots.size();) {
+    const Container container = state.slots[begin].container;
+    size_t end = begin + 1;
+    while (end < state.slots.size() &&
+           state.slots[end].container == container) {
+      ++end;
+    }
+    const auto slots = base::span(state.slots).subspan(begin, end - begin);
+    const size_t container_begin = begin;
+    begin = end;
+    if (!container.IsValid()) {
+      continue;
+    }
+
+    // Tabs keep their closed tabs unless they left the container or moved in
+    // it. When all of them moved (e.g. the whole group), they keep them.
+    std::set<tabs::TabHandle> keepers;
+    for (const Slot& slot : slots) {
+      if (tab_in(slot, container) && !state.moved.contains(slot.tab)) {
+        keepers.insert(slot.tab);
+      }
+    }
+    if (keepers.empty()) {
+      for (const Slot& slot : slots) {
+        if (tab_in(slot, container)) {
+          keepers.insert(slot.tab);
+        }
+      }
+    }
+
+    std::vector<Item> items;
+    std::vector<TabState*> released;
+    bool has_closed_tabs = false;
+    bool all_deleted = true;
+    for (const Slot& slot : slots) {
+      all_deleted &= slot.deleted;
+      if (slot.removed) {
+        AppendClosedTabs(slot.held_before, items);
+        AppendClosedTabs(slot.held_after, items);
+        has_closed_tabs |=
+            !slot.held_before.empty() || !slot.held_after.empty();
+        continue;
+      }
+      tabs::TabInterface* tab = slot.tab.Get();
+      TabState* tab_state = tab ? TabState::From(tab) : nullptr;
+      if (!tab_state) {
+        continue;
+      }
+      AppendClosedTabs(tab_state->closed_before(), items);
+      if (keepers.contains(slot.tab)) {
+        items.emplace_back(tab_state);
+      } else if (HasClosedTabs(*tab_state)) {
+        released.push_back(tab_state);
+      }
+      AppendClosedTabs(tab_state->closed_after(), items);
+      has_closed_tabs |= HasClosedTabs(*tab_state);
+    }
+    if (!has_closed_tabs ||
+        (released.empty() && !std::ranges::any_of(slots, &Slot::removed))) {
+      continue;
+    }
+
+    for (TabState* tab_state : released) {
+      tab_state->SetClosedTabs(ClosedTabs(), ClosedTabs());
+    }
+    if (Distribute(items) || all_deleted) {
+      continue;
+    }
+
+    // The container lost all its tabs while some only left it: keep its
+    // closed tabs in a new carrier tab where it was.
+    Orphans orphans;
+    orphans.container = container;
+    for (size_t i = container_begin; i > 0; --i) {
+      tabs::TabInterface* tab =
+          state.slots[i - 1].removed ? nullptr : state.slots[i - 1].tab.Get();
+      const int index = tab ? model.GetIndexOfTab(tab) : TabStripModel::kNoTab;
+      if (index != TabStripModel::kNoTab) {
+        orphans.index = index + 1;
+        break;
+      }
+    }
+    for (Item& item : items) {
+      orphans.closed_tabs.push_back(std::move(std::get<ClosedTab>(item)));
+    }
+    all_orphans.push_back(std::move(orphans));
+  }
+
+  // Adding tabs notifies observers: done once the slots are no longer used.
+  for (Orphans& orphans : all_orphans) {
+    KeepOrphans(model, state, std::move(orphans));
+  }
+}
+
+void ClosedTabsService::KeepOrphans(TabStripModel& model,
+                                    const ModelState& state,
+                                    Orphans orphans) {
+  if (orphans.closed_tabs.empty()) {
+    return;
+  }
+  std::optional<tab_groups::TabGroupId> group;
+  int index = std::min(orphans.index, model.count());
+  if (orphans.container.group) {
+    group = tab_groups::TabGroupId::GenerateNew();
+    index = std::max(index, model.IndexOfFirstNonPinnedTab());
+  }
+  TabState* carrier = AddTab(model, orphans.closed_tabs.front(), index, group,
+                             orphans.container.pinned, /*select=*/false);
+  if (!carrier) {
+    return;
+  }
+  carrier->SetClosedTabs(
+      ClosedTabs(),
+      ClosedTabs(orphans.closed_tabs.begin() + 1, orphans.closed_tabs.end()));
+  if (!group || !model.group_model() ||
+      !model.group_model()->ContainsTabGroup(*group)) {
+    return;
+  }
+  auto visuals = state.group_visuals.find(*orphans.container.group);
+  if (visuals != state.group_visuals.end()) {
+    model.ChangeTabGroupVisuals(*group, visuals->second);
+  }
+}
+
+bool ClosedTabsService::AreSavedGroupsConnected(TabStripModel& model) {
+  Profile* profile = model.profile();
+  tab_groups::TabGroupSyncService* service =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return true;
+  }
+  auto* observer = static_cast<SavedGroupsObserver*>(
+      service->GetUserData(kSavedGroupsObserverKey));
+  if (observer) {
+    return observer->initialized();
+  }
+  auto on_initialized = base::BindRepeating(
+      [](ClosedTabsService* closed_tabs, Profile* profile) {
+        for (auto& [state_model, state] : closed_tabs->states_) {
+          if (state_model->profile() == profile) {
+            closed_tabs->ScheduleUpdate(state_model);
+          }
+        }
+      },
+      base::Unretained(this), profile);
+  auto owned_observer =
+      std::make_unique<SavedGroupsObserver>(service, std::move(on_initialized));
+  const bool initialized = owned_observer->initialized();
+  service->SetUserData(kSavedGroupsObserverKey, std::move(owned_observer));
+  return initialized;
+}
+
+void ClosedTabsService::Compact(TabStripModel& model) {
+  const bool groups_connected = AreSavedGroupsConnected(model);
+  std::vector<int> to_delete;
+  for (int begin = 0; begin < model.count();) {
+    tabs::TabInterface* first = model.GetTabAtIndex(begin);
+    const Container container{first->IsPinned(), first->GetGroup()};
+    int end = begin + 1;
+    while (end < model.count() &&
+           Container{model.GetTabAtIndex(end)->IsPinned(),
+                     model.GetTabAtIndex(end)->GetGroup()} == container) {
+      ++end;
+    }
+    const int container_begin = begin;
+    begin = end;
+    if (!container.IsValid() || (container.group && !groups_connected)) {
+      continue;
+    }
+
+    std::vector<int> closed;
+    bool has_keeper = false;
+    for (int index = container_begin; index < end; ++index) {
+      tabs::TabInterface* tab = model.GetTabAtIndex(index);
+      const TabState* state = TabState::From(tab);
+      if (!state) {
+        continue;
+      }
+      if (state->IsClosed() && !tab->IsActivated() && !tab->IsSplit()) {
+        closed.push_back(index);
+      } else {
+        has_keeper = true;
+      }
+    }
+    if (closed.empty()) {
+      continue;
+    }
+    // Keep a closed tab, preferably one keeping closed tabs already.
+    if (!has_keeper) {
+      auto carrier = std::ranges::find_if(closed, [&model](int index) {
+        return HasClosedTabs(*TabState::From(model.GetTabAtIndex(index)));
+      });
+      closed.erase(carrier != closed.end() ? carrier : closed.begin());
+      if (closed.empty()) {
+        continue;
+      }
+    }
+
+    std::vector<Item> items;
+    for (int index = container_begin; index < end; ++index) {
+      tabs::TabInterface* tab = model.GetTabAtIndex(index);
+      TabState* state = TabState::From(tab);
+      if (!state) {
+        continue;
+      }
+      AppendClosedTabs(state->closed_before(), items);
+      if (std::ranges::contains(closed, index)) {
+        items.emplace_back(MakeClosedTab(*tab, *state));
+      } else {
+        items.emplace_back(state);
+      }
+      AppendClosedTabs(state->closed_after(), items);
+    }
+    for (int index : closed) {
+      TabState* state = TabState::From(model.GetTabAtIndex(index));
+      if (HasClosedTabs(*state)) {
+        state->SetClosedTabs(ClosedTabs(), ClosedTabs());
+      }
+      to_delete.push_back(index);
+    }
+    Distribute(std::move(items));
+  }
+
+  for (int index : base::Reversed(to_delete)) {
+    model.DetachAndDeleteWebContentsAt(index);
+  }
+}
+
+void ClosedTabsService::TakeSnapshot(TabStripModel& model, ModelState& state) {
+  state.slots.clear();
+  state.moved.clear();
+  state.group_visuals.clear();
+  for (int index = 0; index < model.count(); ++index) {
+    tabs::TabInterface* tab = model.GetTabAtIndex(index);
+    Slot slot;
+    slot.tab = tab->GetHandle();
+    slot.container = Container{tab->IsPinned(), tab->GetGroup()};
+    state.slots.push_back(std::move(slot));
+  }
+  if (TabGroupModel* groups = model.group_model()) {
+    for (const tab_groups::TabGroupId& id : groups->ListTabGroups()) {
+      state.group_visuals[id] = *groups->GetTabGroup(id)->visual_data();
+    }
+  }
+}
