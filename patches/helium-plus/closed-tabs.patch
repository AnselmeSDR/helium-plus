+// While the tab strip cannot be changed (e.g. during a drag), the update is
+// retried after this delay.
+constexpr base::TimeDelta kRetryDelay = base::Milliseconds(500);
+
+const char kSavedGroupsObserverKey[] = "helium_plus.closed_tabs";
+
+// Tells when the TabGroupSyncService of a profile is initialized, kept as its
+// user data.
+class SavedGroupsObserver : public base::SupportsUserData::Data,
+                            public tab_groups::TabGroupSyncService::Observer {
+ public:
+  SavedGroupsObserver(tab_groups::TabGroupSyncService* service,
+                      base::RepeatingClosure on_initialized)
+      : on_initialized_(std::move(on_initialized)) {
+    observation_.Observe(service);
+  }
+
+  bool initialized() const { return initialized_; }
+
+  // tab_groups::TabGroupSyncService::Observer:
+  void OnInitialized() override {
+    initialized_ = true;
+    on_initialized_.Run();
+  }
+  void OnWillBeDestroyed() override { observation_.Reset(); }
+
+ private:
+  bool initialized_ = false;
+  const base::RepeatingClosure on_initialized_;
+  base::ScopedObservation<tab_groups::TabGroupSyncService,
+                          tab_groups::TabGroupSyncService::Observer>
+      observation_{this};
+};
