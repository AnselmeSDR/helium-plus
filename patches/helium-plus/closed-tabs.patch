+// A tab keeping closed tabs, or a closed tab, of a container in display order.
+using Item = std::variant<TabState*, ClosedTab>;
+
+bool HasClosedTabs(const TabState& state) {
+  return !state.closed_before().empty() || !state.closed_after().empty();
+}
+
+bool SameClosedTabs(const ClosedTabs& a, const ClosedTabs& b) {
+  return std::ranges::equal(a, b, {}, &ClosedTab::id, &ClosedTab::id);
+}
+
+void AppendClosedTabs(const ClosedTabs& closed_tabs, std::vector<Item>& items) {
+  for (const ClosedTab& closed_tab : closed_tabs) {
+    items.emplace_back(closed_tab);
+  }
+}
+
+// Spreads the closed tabs of `items` over the tabs of `items`: the closed tabs
+// before the first tab go before it, the others after the tab preceding them.
+// Returns false, changing nothing, when `items` has no tab.
+bool Distribute(std::vector<Item> items) {
+  ClosedTabs leading;
+  std::vector<std::pair<TabState*, ClosedTabs>> keepers;
+  for (Item& item : items) {
+    if (TabState** state = std::get_if<TabState*>(&item)) {
+      keepers.emplace_back(*state, ClosedTabs());
+    } else if (keepers.empty()) {
+      leading.push_back(std::move(std::get<ClosedTab>(item)));
+    } else {
+      keepers.back().second.push_back(std::move(std::get<ClosedTab>(item)));
+    }
+  }
+  if (keepers.empty()) {
+    return false;
+  }
+  for (size_t i = 0; i < keepers.size(); ++i) {
+    auto& [state, after] = keepers[i];
+    ClosedTabs before = i == 0 ? std::move(leading) : ClosedTabs();
+    if (!SameClosedTabs(state->closed_before(), before) ||
+        !SameClosedTabs(state->closed_after(), after)) {
+      state->SetClosedTabs(std::move(before), std::move(after));
+    }
+  }
+  return true;
+}
+
+ClosedTab MakeClosedTab(tabs::TabInterface& tab, const TabState& state) {
+  if (state.anchor_url().is_valid()) {
+    return ClosedTab(state.anchor_url(), state.anchor_title(),
+                     state.custom_title());
+  }
+  content::WebContents* contents = tab.GetContents();
+  return ClosedTab(contents->GetVisibleURL(), contents->GetTitle(),
+                   state.custom_title());
+}
+
+BrowserWindowInterface* GetBrowser(TabStripModel& model) {
+  BrowserWindowInterface* result = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetTabStripModel() != &model) {
+          return true;
+        }
+        result = browser;
+        return false;
+      });
+  return result;
+}
+
+// Adds a tab for `closed_tab` at `index`: an active one, or a closed one that
+// does not load.
+TabState* AddTab(TabStripModel& model,
+                 const ClosedTab& closed_tab,
+                 int index,
+                 std::optional<tab_groups::TabGroupId> group,
+                 bool pin,
+                 bool select) {
+  BrowserWindowInterface* browser = GetBrowser(model);
+  if (!browser) {
+    return nullptr;
+  }
+  // No page state: the restore loads the URL from scratch. A page state made
+  // from a new NavigationEntry gets the renderer killed on commit.
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(closed_tab.url);
+  navigation.set_original_request_url(closed_tab.url);
+  navigation.set_title(closed_tab.title);
+  navigation.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  navigation.set_timestamp(base::Time::Now());
+
+  std::map<std::string, std::string> extra_data;
+  extra_data[kAnchorUrlKey] = closed_tab.url.spec();
+  if (!closed_tab.title.empty()) {
+    extra_data[kAnchorTitleKey] = base::UTF16ToUTF8(closed_tab.title);
+  }
+  if (!closed_tab.custom_title.empty()) {
+    extra_data[kCustomTitleKey] = base::UTF16ToUTF8(closed_tab.custom_title);
+  }
+  if (!select) {
+    extra_data[kClosedKey] = "1";
+  }
+
+  content::WebContents* contents = chrome::AddRestoredTab(
+      browser, base::span_from_ref(navigation), index,
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(), group,
+      select, pin, select ? base::TimeTicks::Now() : base::TimeTicks(),
+      select ? base::Time::Now() : base::Time(),
+      /*storage_namespace=*/nullptr, sessions::SerializedUserAgentOverride(),
+      extra_data, /*from_session_restore=*/!select,
+      /*is_active_browser=*/std::nullopt,
+      select ? chrome::RestoredTabLoadPolicy::kLoadIfVisible
+             : chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+  return contents ? TabState::FromWebContents(contents) : nullptr;
+}
+
+// Moves an insertion `index` out of the split tab around it, after it when
+// `forward`, else before it.
+int SkipSplit(TabStripModel& model, int index, bool forward) {
+  if (index <= 0 || index >= model.count()) {
+    return index;
+  }
+  const std::optional<split_tabs::SplitTabId> split =
+      model.GetTabAtIndex(index)->GetSplit();
+  if (!split || model.GetTabAtIndex(index - 1)->GetSplit() != split) {
+    return index;
+  }
+  if (forward) {
+    while (index < model.count() &&
+           model.GetTabAtIndex(index)->GetSplit() == split) {
+      ++index;
+    }
+  } else {
+    while (index > 0 && model.GetTabAtIndex(index - 1)->GetSplit() == split) {
+      --index;
+    }
+  }
+  return index;
+}
